{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  // Los valores secretos NO van en este archivo.
  //  - Local: dotnet user-secrets set "ConnectionStrings:DefaultConnection" "..."
  //  - Azure: App Service > Configuración (ConnectionStrings__DefaultConnection, Jwt__Key, Correo__Clave)
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  // Azure Blob Storage: sin claves. Local usa tu cuenta (Visual Studio / az login);
  // en Azure, la Managed Identity del App Service.
  "BlobStorage": {
    "AccountUrl": "https://statacademyarchivos.blob.core.windows.net",
    "ContenedorImagenes": "imagenes",
    "ContenedorDocumentos": "documentos",
    "ManagedIdentityClientId": "",
    // Directorio de la cuenta de almacenamiento (no es secreto). Solo se usa en local.
    "TenantId": "8299a768-4817-4deb-826d-451fecb735e9",
    "MaxImagenMB": 5,
    "MaxDocumentoMB": 20
  },

  "Jwt": {
    "Issuer": "STAT_Academy.Api",
    "Audience": "STAT_Academy",
    "Key": "",
    "ExpiracionMinutos": 60
  },
  // Avisos por correo a los administradores cuando hay errores 500 (límite anti-spam).
  "Errores": {
    "MinutosEntreAvisos": 15,
    "MaxAvisosPorHora": 20
  },
  // Datos para pagar por SINPE Móvil o transferencia (se muestran a los compradores; no son secretos).
  // PENDIENTE: reemplazar por los datos reales de STATMEDICAL (en Azure: Pagos__SinpeTelefono, etc.).
  "Pagos": {
    "SinpeTelefono": "0000-0000",
    "SinpeNombre": "STATMEDICAL",
    "Banco": "Banco por definir",
    "CuentaIban": "CR00 0000 0000 0000 0000 00",
    "CuentaTitular": "STATMEDICAL",
    "CedulaJuridica": ""
  },
  "AllowedHosts": "*"
}
