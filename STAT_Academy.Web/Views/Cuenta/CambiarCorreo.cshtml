@model STAT_Academy.Web.Models.Correo.SolicitarCambioCorreoViewModel

@{
    ViewData["Title"] = "Cambiar correo";
}

<section class="section">
    <div class="card auth-card">
        <span class="eyebrow">Seguridad de la cuenta</span>

        <h1>Cambiar correo</h1>

        <p>
            Escriba su contraseña actual y la dirección de correo
            nueva. Enviaremos un enlace de confirmación al correo nuevo.
        </p>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-success" role="alert">
                @ViewBag.Mensaje
            </div>
        }

        <form asp-action="CambiarCorreo" method="post">
            <div
                asp-validation-summary="ModelOnly"
                class="text-danger mb-3">
            </div>

            <div class="form-group mb-3">
                <label asp-for="contrasenaActual"></label>

                <input
                    asp-for="contrasenaActual"
                    class="form-control"
                    autocomplete="current-password" />

                <span
                    asp-validation-for="contrasenaActual"
                    class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="nuevoEmail"></label>

                <input
                    asp-for="nuevoEmail"
                    class="form-control"
                    autocomplete="email" />

                <span
                    asp-validation-for="nuevoEmail"
                    class="text-danger">
                </span>
            </div>

            <button
                class="btn btn-primary w-100"
                type="submit">
                Enviar confirmación
            </button>
        </form>

        <div class="mt-3">
            <a
                class="text-link"
                asp-controller="Home"
                asp-action="Index">
                Volver al inicio
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}