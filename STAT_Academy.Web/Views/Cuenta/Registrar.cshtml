@model STAT_Academy.Web.Models.Cuenta.RegistroViewModel
@{
    ViewData["Title"] = "Registro";
}

<div class="auth-split">
    <aside class="auth-brand" aria-labelledby="auth-brand-titulo">
        <div class="auth-brand__contenido">
            @Html.Logo("auth-brand__logo", 56)
            <h2 id="auth-brand-titulo" class="auth-brand__titulo">Aprenda con cursos pensados para profesionales</h2>
            <p class="auth-brand__texto">Cree su cuenta gratis y empiece hoy mismo.</p>
            <ul class="auth-brand__lista">
                <li>@Html.Icono("check")<span>Cursos guiados por tutores</span></li>
                <li>@Html.Icono("check")<span>Avance a su ritmo, desde cualquier dispositivo</span></li>
                <li>@Html.Icono("check")<span>Su progreso y sus compras siempre a mano</span></li>
            </ul>
        </div>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-titulo">
        <div class="auth-form">
            <h1 id="auth-titulo">Crear cuenta</h1>
            <p class="auth-form__intro">Complete sus datos. La contraseña debe tener al menos 8 caracteres.</p>

            <form asp-action="Registrar" method="post" novalidate data-un-solo-envio>
                <div asp-validation-summary="ModelOnly" class="aviso aviso--error" role="alert"></div>

                <div class="form-group">
                    <label asp-for="nombre"></label>
                    <input asp-for="nombre" autocomplete="name" />
                    <span asp-validation-for="nombre" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="email"></label>
                    <input asp-for="email" type="email" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="password"></label>
                    <div class="campo-contrasena">
                        <input asp-for="password" autocomplete="new-password" />
                        <partial name="_BotonVerContrasena" />
                    </div>
                    <span asp-validation-for="password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="confirmarPassword"></label>
                    <div class="campo-contrasena">
                        <input asp-for="confirmarPassword" autocomplete="new-password" />
                        <partial name="_BotonVerContrasena" />
                    </div>
                    <span asp-validation-for="confirmarPassword" class="text-danger"></span>
                </div>

                <div class="form-group registro-terminos">
                    <div class="form-check">
                        <input asp-for="aceptaTerminos" class="form-check-input" data-habilita-envio />
                        <label asp-for="aceptaTerminos" class="form-check-label">
                            He leído y acepto los
                            <a asp-controller="Home" asp-action="Terminos" target="_blank" rel="noopener" data-sin-carga>términos y condiciones<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>
                            y la
                            <a asp-controller="Home" asp-action="Cookies" target="_blank" rel="noopener" data-sin-carga>política de cookies<span class="visually-hidden"> (se abre en una pestaña nueva)</span></a>.
                        </label>
                    </div>
                    <span asp-validation-for="aceptaTerminos" class="text-danger"></span>
                    <p id="registro-terminos-ayuda" class="form-text" data-ayuda-envio hidden>Marque la casilla para habilitar el botón de registro.</p>
                </div>

                <button class="btn btn-primary btn-lg w-100" type="submit" aria-describedby="registro-terminos-ayuda">Registrarme</button>
            </form>

            <div class="auth-form__enlaces">
                <span>¿Ya tiene cuenta? <a class="enlace-accion" asp-action="Login">Iniciar sesión</a></span>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
