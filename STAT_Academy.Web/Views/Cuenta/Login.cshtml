@model STAT_Academy.Web.Models.Cuenta.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-split">
    <aside class="auth-brand" aria-labelledby="auth-brand-titulo">
        <div class="auth-brand__contenido">
            @Html.Logo("auth-brand__logo", 56)
            <h2 id="auth-brand-titulo" class="auth-brand__titulo">Bienvenido de nuevo a su formación</h2>
            <p class="auth-brand__texto">Retome sus cursos donde los dejó y siga avanzando a su ritmo.</p>
            <ul class="auth-brand__lista">
                <li>@Html.Icono("check")<span>Acceso a sus cursos y lecciones</span></li>
                <li>@Html.Icono("check")<span>Seguimiento de su progreso</span></li>
                <li>@Html.Icono("check")<span>Facturas y pagos en un solo lugar</span></li>
            </ul>
        </div>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-titulo">
        <div class="auth-form">
            <h1 id="auth-titulo">Iniciar sesión</h1>
            <p class="auth-form__intro">Ingrese con el correo y la contraseña de su cuenta.</p>

            <form asp-action="Login" data-un-solo-envio asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="aviso aviso--error" role="alert"></div>

                <div class="form-group">
                    <label asp-for="email"></label>
                    <input asp-for="email" type="email" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="password"></label>
                    <div class="campo-contrasena">
                        <input asp-for="password" autocomplete="current-password" />
                        <partial name="_BotonVerContrasena" />
                    </div>
                    <span asp-validation-for="password" class="text-danger"></span>
                </div>

                <button class="btn btn-primary btn-lg w-100" type="submit">Ingresar</button>
            </form>

            <div class="auth-form__enlaces">
                <a class="enlace-accion" asp-action="Forgotpassword">¿Olvidó su contraseña?</a>
                <span>¿No tiene cuenta? <a class="enlace-accion" asp-action="Registrar">Crear cuenta</a></span>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
