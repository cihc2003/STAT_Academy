@model STAT_Academy.Web.Models.Contrasena.RestablecerContrasenaViewModel

@{
    ViewData["Title"] = "Restablecer contraseña";
}

<section class="section">
    <div class="card auth-card">
        <span class="eyebrow">Nueva contraseña</span>

        <h1>Restablecer contraseña</h1>

        <p>
            Escriba y confirme la nueva contraseña para su cuenta.
        </p>

        <form asp-action="RestablecerContrasena" method="post">
            <div
                asp-validation-summary="ModelOnly"
                class="text-danger mb-3">
            </div>

            <input asp-for="token" type="hidden" />

            <div class="form-group mb-3">
                <label asp-for="nuevaContrasena"></label>

                <input
                    asp-for="nuevaContrasena"
                    class="form-control"
                    autocomplete="new-password" />

                <span
                    asp-validation-for="nuevaContrasena"
                    class="text-danger">
                </span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="confirmarContrasena"></label>

                <input
                    asp-for="confirmarContrasena"
                    class="form-control"
                    autocomplete="new-password" />

                <span
                    asp-validation-for="confirmarContrasena"
                    class="text-danger">
                </span>
            </div>

            <button
                class="btn btn-primary w-100"
                type="submit">
                Guardar contraseña nueva
            </button>
        </form>

        <div class="mt-3">
            <a
                class="text-link"
                asp-controller="Cuenta"
                asp-action="Login">
                Volver al inicio de sesión
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
