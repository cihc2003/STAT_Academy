@model STAT_Academy.Web.Models.Contrasena.SolicitarRecuperacionViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="auth-split">
    <aside class="auth-brand" aria-labelledby="auth-brand-titulo">
        <div class="auth-brand__contenido">
            <h2 id="auth-brand-titulo" class="auth-brand__titulo">Recupere el acceso a su cuenta</h2>
            <p class="auth-brand__texto">Le enviaremos un enlace para crear una contraseña nueva.</p>
            <ul class="auth-brand__lista">
                <li>@Html.Icono("check")<span>Revise también la carpeta de correo no deseado</span></li>
                <li>@Html.Icono("check")<span>Sus cursos y compras se conservan</span></li>
            </ul>
        </div>
    </aside>

    <section class="auth-panel" aria-labelledby="auth-titulo">
        <div class="auth-form">
            <a class="enlace-volver" asp-controller="Cuenta" asp-action="Login">@Html.Icono("flecha-izquierda", "icono--sm")Iniciar sesión</a>
            <h1 id="auth-titulo">Recuperar contraseña</h1>
            <p class="auth-form__intro">Escriba el correo de su cuenta. Si está registrado, recibirá un enlace de recuperación.</p>

            @if (ViewBag.Mensaje != null)
            {
                <aviso tipo="exito">@ViewBag.Mensaje</aviso>
            }

            <form asp-action="Forgotpassword" method="post" novalidate data-un-solo-envio>
                <div asp-validation-summary="ModelOnly" class="aviso aviso--error" role="alert"></div>

                <div class="form-group">
                    <label asp-for="email"></label>
                    <input asp-for="email" class="form-control" type="email" autocomplete="email" inputmode="email" />
                    <span asp-validation-for="email" class="text-danger"></span>
                </div>

                <button class="btn btn-primary btn-lg w-100" type="submit">@Html.Icono("enviar")Enviar enlace de recuperación</button>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
