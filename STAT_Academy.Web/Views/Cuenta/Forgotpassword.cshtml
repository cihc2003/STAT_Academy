@model STAT_Academy.Web.Models.Contrasena.SolicitarRecuperacionViewModel

@{
    ViewData["Title"] = "Recuperar contraseña";
}

<section class="section">
    <div class="card auth-card">
        <span class="eyebrow">Recuperación segura</span>

        <h1>Recuperar contraseña</h1>

        <p>
            Escriba el correo electrónico asociado con su cuenta.
            Si está registrado, recibirá un enlace de recuperación.
        </p>

        @if (ViewBag.Mensaje != null)
        {
            <div class="alert alert-success" role="alert">
                @ViewBag.Mensaje
            </div>
        }

        <form asp-action="Forgotpassword" method="post">
            <div
                asp-validation-summary="ModelOnly"
                class="text-danger mb-3">
            </div>

            <div class="form-group mb-3">
                <label asp-for="email"></label>

                <input
                    asp-for="email"
                    class="form-control"
                    autocomplete="email" />

                <span
                    asp-validation-for="email"
                    class="text-danger">
                </span>
            </div>

            <button
                class="btn btn-primary w-100"
                type="submit">
                Enviar enlace de recuperación
            </button>
        </form>

        <div class="mt-3">
            <a
                class="text-link"
                asp-controller="Cuenta"
                asp-action="Login">
                Volver al inicio de sesión
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}