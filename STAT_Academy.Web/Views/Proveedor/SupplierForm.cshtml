@model STAT_Academy.Web.Models.Proveedor.ProveedorCreateRequest

@{
    var isEdit = Context.Request.Query.ContainsKey("id") || ViewContext.RouteData.Values.ContainsKey("id");
    ViewData["Title"] = isEdit ? "Editar proveedor" : "Nuevo proveedor";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section>
        <a class="enlace-volver" asp-action="Index">@Html.Icono("flecha-izquierda", "icono--sm")Proveedores</a>

        <div class="panel-encabezado">
            <div>
                <span class="eyebrow">Administración</span>
                <h1>@ViewData["Title"]</h1>
                <p>Datos de la empresa y de la persona de contacto.</p>
            </div>
        </div>

        <form asp-action="SupplierForm" method="post" class="form-card panel-form">
            <div asp-validation-summary="ModelOnly" class="aviso aviso--error"></div>

            <div class="row g-3">
                <div class="col-md-6 form-group">
                    <label asp-for="nombre"></label>
                    <input asp-for="nombre" class="form-control" />
                    <span asp-validation-for="nombre" class="text-danger small"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="contacto"></label>
                    <input asp-for="contacto" class="form-control" />
                    <span asp-validation-for="contacto" class="text-danger small"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="telefono"></label>
                    <input asp-for="telefono" class="form-control" type="tel" />
                    <span asp-validation-for="telefono" class="text-danger small"></span>
                </div>

                <div class="col-md-6 form-group">
                    <label asp-for="email"></label>
                    <input asp-for="email" class="form-control" type="email" />
                    <span asp-validation-for="email" class="text-danger small"></span>
                </div>
            </div>

            <div class="panel-form__acciones">
                <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
                <button class="btn btn-primary" type="submit">Guardar</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
