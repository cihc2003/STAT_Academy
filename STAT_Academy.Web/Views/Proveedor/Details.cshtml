@model STAT_Academy.Web.Models.Proveedor.ProveedorResponse

@{
    ViewData["Title"] = "Detalle de proveedor";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section class="card p-4">
        <span class="eyebrow">Administración</span>
        <h1>Detalle de proveedor</h1>

        <div class="row g-3 mt-2">
            <div class="col-md-6 form-group">
                <label>Nombre</label>
                <input class="form-control" value="@Model.nombre" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Contacto</label>
                <input class="form-control" value="@Model.contacto" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Teléfono</label>
                <input class="form-control" value="@Model.telefono" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Correo</label>
                <input class="form-control" value="@Model.email" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Estado</label>
                <input class="form-control" value="@(Model.estado ? "Activo" : "Inactivo")" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Creado</label>
                <input class="form-control" value="@Model.fecha_creacion.ToString("yyyy-MM-dd HH:mm")" readonly />
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
            <a class="btn btn-outline-primary" asp-action="SupplierForm" asp-route-id="@Model.id">Editar</a>

            @if (Model.estado)
            {
                <form asp-action="ToggleSupplier" asp-route-id="@Model.id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger" type="submit">Desactivar</button>
                </form>
            }
        </div>
    </section>
</div>