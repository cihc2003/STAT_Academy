@model IEnumerable<Order>
@{ ViewData["Title"] = "Mis pedidos"; }
<section class="section"><div class="container"><h1>Mis pedidos</h1><div class="table-card"><table class="table mb-0"><thead><tr><th>Fecha</th><th>Total</th><th>Estado</th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.CreatedAt.ToLocalTime().ToShortDateString()</td><td>@o.Total.ToString("C")</td><td>@o.Status</td></tr>}</tbody></table></div></div></section>
