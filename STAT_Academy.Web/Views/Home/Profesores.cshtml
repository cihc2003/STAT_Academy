@{
    ViewData["Title"] = "Profesores";
    ViewData["Page"] = "Profesores";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">Equipo docente</span>
        <h1>Profesores con experiencia aplicada</h1>
        <p>Aprende con especialistas que combinan fundamentos teóricos, proyectos reales y acompañamiento cercano.</p>
    </div>
</section>

<section class="section">
    <div class="container card-grid four">
        <article class="card teacher-card">
            <div class="avatar avatar-one" role="img" aria-label="Profesora de estadística"></div>
            <h3>Dra. Valeria Ramos</h3>
            <span>Estadística aplicada</span>
            <p>Especialista en inferencia, diseño experimental y análisis para investigación académica.</p>
        </article>
        <article class="card teacher-card">
            <div class="avatar avatar-two" role="img" aria-label="Profesor de ciencia de datos"></div>
            <h3>Ing. Daniel Herrera</h3>
            <span>Ciencia de datos</span>
            <p>Consultor en modelos predictivos, automatización con Python y productos analíticos.</p>
        </article>
        <article class="card teacher-card">
            <div class="avatar avatar-three" role="img" aria-label="Profesora de business intelligence"></div>
            <h3>Lic. Andrea Molina</h3>
            <span>Inteligencia de Negocios</span>
            <p>Experta en paneles, KPI, Power BI y visualización para equipos directivos.</p>
        </article>
        <article class="card teacher-card">
            <div class="avatar avatar-four" role="img" aria-label="Profesor de investigación cuantitativa"></div>
            <h3>MSc. Roberto Castillo</h3>
            <span>Investigación cuantitativa</span>
            <p>Docente en metodología, encuestas, muestreo y comunicación de resultados.</p>
        </article>
    </div>
</section>

<section class="section mission-section">
    <div class="container card-grid two">
        <article class="info-block">
            <span class="eyebrow">Misión</span>
            <h2>Formar talento analítico con criterio</h2>
            <p>Impulsamos el aprendizaje práctico de estadística y datos para que estudiantes y profesionales puedan resolver problemas reales con evidencia, claridad y responsabilidad.</p>
        </article>
        <article class="info-block">
            <span class="eyebrow">Visión</span>
            <h2>Ser referencia regional en educación de datos</h2>
            <p>Aspiramos a convertirnos en una academia líder para quienes buscan dominar herramientas cuantitativas y transformar información en decisiones inteligentes.</p>
        </article>
    </div>
</section>
