@model STAT_Academy.Web.Models.Home.InicioViewModel
@{
    ViewData["Title"] = "Formación en salud";
    var autenticado = User.Identity?.IsAuthenticated == true;
    var esCliente = User.IsInRole("Cliente");
    var cursos = Model.Cursos;
    var productos = Model.Productos;
    var articulos = Model.Articulos;
}

@* 1. Portada: mensaje y agenda real de próximos inicios *@
<section class="inicio-hero" aria-labelledby="inicio-titulo">
    @* Trazo de electrocardiograma: se dibuja una vez al cargar (decorativo). *@
    <svg class="inicio-hero__pulso" viewBox="0 0 1200 80" preserveAspectRatio="none" aria-hidden="true" focusable="false">
        <path pathLength="1" d="M0 52 H120 l14 -10 l14 10 h22 l8 10 l12 -58 l12 74 l8 -26 h34 l20 -12 l20 12 H420 l14 -10 l14 10 h22 l8 10 l12 -58 l12 74 l8 -26 h34 l20 -12 l20 12 H720 l14 -10 l14 10 h22 l8 10 l12 -58 l12 74 l8 -26 h34 l20 -12 l20 12 H1020 l14 -10 l14 10 h22 l8 10 l12 -58 l12 74 l8 -26 h34 l20 -12 l20 12 H1200" />
    </svg>
    <div class="container inicio-hero__grid">
        <div class="inicio-hero__texto">
            <p class="inicio-hero__marca">Academia de STATMEDICAL</p>
            <h1 id="inicio-titulo" class="inicio-hero__titulo">Formación en salud que empieza a tiempo.</h1>
            <p class="inicio-hero__bajada">
                Cursos con tutor y fecha de inicio definida, materiales para la práctica clínica y
                artículos educativos, en un mismo lugar.
            </p>
            <div class="inicio-hero__acciones">
                <a class="btn btn-primary btn-lg" asp-controller="Curso" asp-action="Index">Ver cursos</a>
                <a class="btn btn-secundario btn-lg" asp-controller="Products" asp-action="Index">Ir a la tienda</a>
            </div>

            @if (Model.CursosDisponibles || Model.ProductosDisponibles)
            {
                <dl class="cifras" aria-label="STAT Academy en cifras">
                    @if (Model.CursosDisponibles)
                    {
                        <div class="cifras__item">
                            <dt>@(cursos.Count == 1 ? "curso con inscripción abierta" : "cursos con inscripción abierta")</dt>
                            <dd><span class="visually-hidden">@cursos.Count</span><span aria-hidden="true" data-contar="@cursos.Count">@cursos.Count</span></dd>
                        </div>
                        @if (Model.Instructores > 0)
                        {
                            <div class="cifras__item">
                                <dt>@(Model.Instructores == 1 ? "tutor a cargo" : "tutores a cargo")</dt>
                                <dd><span class="visually-hidden">@Model.Instructores</span><span aria-hidden="true" data-contar="@Model.Instructores">@Model.Instructores</span></dd>
                            </div>
                        }
                    }
                    @if (Model.ProductosDisponibles)
                    {
                        <div class="cifras__item">
                            <dt>@(productos.Count == 1 ? "producto en la tienda" : "productos en la tienda")</dt>
                            <dd><span class="visually-hidden">@productos.Count</span><span aria-hidden="true" data-contar="@productos.Count">@productos.Count</span></dd>
                        </div>
                        @if (Model.Categorias.Count > 0)
                        {
                            <div class="cifras__item">
                                <dt>@(Model.Categorias.Count == 1 ? "categoría" : "categorías")</dt>
                                <dd><span class="visually-hidden">@Model.Categorias.Count</span><span aria-hidden="true" data-contar="@Model.Categorias.Count">@Model.Categorias.Count</span></dd>
                            </div>
                        }
                    }
                </dl>
            }
        </div>

        <div class="inicio-hero__visual">
            @* Foto de dominio público (U.S. Navy, Wikimedia Commons); créditos en wwwroot/img/fotos/CREDITOS.md.
               Es la imagen más grande de la portada: se pide con prioridad y con medidas para no mover el diseño. *@
            <picture class="inicio-hero__foto">
                <source type="image/webp"
                        srcset="/img/fotos/paramedicos-ambulancia-640.webp 640w, /img/fotos/paramedicos-ambulancia-1280.webp 1280w"
                        sizes="(min-width: 992px) 45vw, 100vw" />
                <img src="/img/fotos/paramedicos-ambulancia-1280.jpg" width="1280" height="853"
                     alt="Equipo de paramédicos junto a su ambulancia" fetchpriority="high" decoding="async" />
            </picture>
            <aside class="agenda fondo-oscuro" aria-labelledby="agenda-titulo">
                <div class="agenda__cabecera">
                    <h2 id="agenda-titulo" class="agenda__titulo">Próximos inicios</h2>
                    @Html.Icono("calendario", "icono--lg")
                </div>

                @if (cursos.Count > 0)
                {
                    <ol class="agenda__lista">
                        @foreach (var c in Model.ProximosInicios)
                        {
                            <li>
                                <a class="agenda__item" asp-controller="Curso" asp-action="Details" asp-route-id="@c.Id">
                                    <time class="agenda__fecha" datetime="@c.Fecha_Inicio.ToString("yyyy-MM-dd")">
                                        <span class="agenda__dia">@c.Fecha_Inicio.Day</span>
                                        <span class="agenda__mes">@Formato.MesCorto(c.Fecha_Inicio)</span>
                                    </time>
                                    <span class="agenda__curso">
                                        <strong>@c.Nombre</strong>
                                        <span class="agenda__datos">
                                            <span>@Formato.Semanas(c.Duracion_Semanas)</span>
                                            <span>@Formato.PrecioCurso(c.Precio_Base)</span>
                                        </span>
                                    </span>
                                    @Html.Icono("chevron-derecha", "agenda__flecha")
                                </a>
                            </li>
                        }
                    </ol>
                    <a class="btn btn-claro agenda__boton" asp-controller="Curso" asp-action="Index">
                        @(cursos.Count == 1 ? "Ver el curso disponible" : $"Ver los {cursos.Count} cursos disponibles")
                    </a>
                }
                else
                {
                    <div class="agenda__vacia">
                        <p><strong>No hay inicios programados por ahora.</strong></p>
                        <p>Los cursos nuevos aparecen aquí con su fecha de inicio en cuanto abren inscripción.</p>
                        <a class="btn btn-contorno-claro" asp-controller="Blog" asp-action="Index">Leer el blog mientras tanto</a>
                    </div>
                }
            </aside>
        </div>
    </div>
</section>

@* 2. Cursos con inscripción abierta *@
@if (cursos.Count > 0)
{
    <section class="section section--alterna" aria-labelledby="inicio-cursos">
        <div class="container">
            <div class="cabecera-seccion">
                <div>
                    <h2 id="inicio-cursos">Cursos con inscripción abierta</h2>
                    <p>Ordenados por fecha de inicio. Cada curso indica su duración, tutor y precio.</p>
                </div>
                <a class="enlace-accion" asp-controller="Curso" asp-action="Index">Ver todos los cursos @Html.Icono("flecha-derecha", "icono--sm")</a>
            </div>
            <div class="rejilla">
                @foreach (var c in cursos.Take(8))
                {
                    <partial name="_CursoTarjeta" model="c" />
                }
            </div>
        </div>
    </section>
}

@* 3. Tienda: categorías reales y productos disponibles *@
@if (productos.Count > 0)
{
    <section class="section" aria-labelledby="inicio-tienda">
        <div class="container">
            <div class="cabecera-seccion">
                <div>
                    <h2 id="inicio-tienda">Materiales para la práctica</h2>
                    <p>Insumos y recursos educativos de la tienda de STATMEDICAL.</p>
                </div>
                <a class="enlace-accion" asp-controller="Products" asp-action="Index">Ver la tienda @Html.Icono("flecha-derecha", "icono--sm")</a>
            </div>

            @if (Model.Categorias.Count > 1)
            {
                <nav class="lista-chips" aria-label="Categorías de la tienda">
                    @foreach (var (nombre, cantidad) in Model.Categorias)
                    {
                        <a class="chip" asp-controller="Products" asp-action="Index" asp-route-categoria="@nombre">
                            @nombre <span class="chip__cantidad"><span class="visually-hidden">, </span>@cantidad<span class="visually-hidden"> @(cantidad == 1 ? "producto" : "productos")</span></span>
                        </a>
                    }
                </nav>
            }

            <div class="rejilla">
                @foreach (var p in productos.Take(8))
                {
                    <partial name="_ProductoTarjeta" model="p" />
                }
            </div>
        </div>
    </section>
}

@* 4. Blog *@
@if (articulos.Count > 0)
{
    <section class="section section--alterna" aria-labelledby="inicio-blog">
        <div class="container">
            <div class="cabecera-seccion">
                <div>
                    <h2 id="inicio-blog">Del blog</h2>
                    <p>Artículos recientes del equipo docente.</p>
                </div>
                <a class="enlace-accion" asp-controller="Blog" asp-action="Index">Ver todos los artículos @Html.Icono("flecha-derecha", "icono--sm")</a>
            </div>
            @{
                var destacada = articulos[0];
                var vistaDestacada = new ViewDataDictionary(ViewData) { ["Nivel"] = "h3", ["SinGestion"] = true };
            }
            <partial name="~/Views/Blog/_BlogDestacada.cshtml" model="destacada" view-data="vistaDestacada" />
            @if (articulos.Count > 1)
            {
                <div class="blog-lista inicio-blog__lista">
                    @foreach (var a in articulos.Skip(1).Take(2))
                    {
                        <partial name="~/Views/Blog/_BlogTarjeta.cshtml" model="a" />
                    }
                </div>
            }
        </div>
    </section>
}

@* 5. Cierre: siguiente paso según quién visita *@
@if (!autenticado || esCliente)
{
    <section class="banda banda--foto fondo-oscuro" aria-labelledby="inicio-cierre">
        <picture class="banda__foto">
            <source type="image/webp"
                    srcset="/img/fotos/paramedico-equipo-640.webp 640w, /img/fotos/paramedico-equipo-1280.webp 1280w"
                    sizes="(min-width: 992px) 50vw, 100vw" />
            <img src="/img/fotos/paramedico-equipo-1280.jpg" width="1280" height="853"
                 alt="" loading="lazy" decoding="async" />
        </picture>
        <div class="container banda__grid">
            @if (!autenticado)
            {
                <div>
                    <h2 id="inicio-cierre">Cree su cuenta para inscribirse</h2>
                    <p>Con una cuenta puede comprar cursos y productos, entregar tareas y consultar sus calificaciones.</p>
                </div>
                <div class="banda__acciones">
                    <a class="btn btn-primary btn-lg" asp-controller="Cuenta" asp-action="Registrar">Crear cuenta</a>
                    <a class="btn btn-contorno-claro btn-lg" asp-controller="Cuenta" asp-action="Login">Ya tengo cuenta</a>
                </div>
            }
            else
            {
                <div>
                    <h2 id="inicio-cierre">Siga con sus cursos</h2>
                    <p>Revise sus tareas pendientes, materiales y calificaciones.</p>
                </div>
                <div class="banda__acciones">
                    <a class="btn btn-primary btn-lg" asp-controller="Curso" asp-action="MisCursos">Ir a mis cursos</a>
                    <a class="btn btn-contorno-claro btn-lg" asp-controller="Facturas" asp-action="Index">Ver facturas y pedidos</a>
                </div>
            }
        </div>
    </section>
}
