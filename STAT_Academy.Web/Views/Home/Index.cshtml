
@{
    ViewData["Title"] = "Inicio";
    ViewData["Page"] = "Inicio";

    // ==========================================
    // CURSOS DESTACADOS
    // ==========================================

    var featuredCourses = new[]
    {
        new
        {
            Id = 1,
            Category = "Medicina en áreas remotas",
            Title = "Primeros auxilios en áreas remotas",
            Description = "Desarrollá habilidades para brindar primeros auxilios en entornos naturales y lugares de difícil acceso.",
            Image = "/images/courses/areas-remotas.jpg"
        },
        new
        {
            Id = 2,
            Category = "Reanimación cardiopulmonar",
            Title = "RCP para profesionales de la salud",
            Description = "Fortalecé tus conocimientos y habilidades de reanimación cardiopulmonar en el ámbito de la salud.",
            Image = "/images/courses/rcp-profesionales.jpg"
        },
        new
        {
            Id = 3,
            Category = "Trauma prehospitalario",
            Title = "Manejo avanzado del trauma prehospitalario",
            Description = "Profundizá en la valoración y atención inicial de pacientes con lesiones traumáticas en el entorno prehospitalario.",
            Image = "/images/courses/trauma-prehospitalario.jpg"
        }
    };

    // ==========================================
    // PRODUCTOS DESTACADOS
    // ==========================================

    var featuredProducts = new[]
    {
        new
        {
            Id = 1,
            Category = "Primeros auxilios",
            Name = "Botiquines de primeros auxilios",
            Description = "Equipos y suministros para la atención inicial de emergencias.",
            Image = "/images/products/botiquin.jpg"
        },
        new
        {
            Id = 2,
            Category = "Control de hemorragias",
            Name = "Torniquete SAM XT",
            Description = "Torniquete diseñado para el control de hemorragias graves en extremidades.",
            Image = "/images/products/sam-xt.jpg"
        },
        new
        {
            Id = 3,
            Category = "Material educativo",
            Name = "Manuales y guías de emergencias",
            Description = "Material educativo para formación y consulta en atención de emergencias.",
            Image = "/images/products/manuales.jpg"
        }
    };

    // ==========================================
    // ARTÍCULOS EDUCATIVOS
    // ==========================================

    
var featuredPosts = new[]
{
    new
    {
        Category = "Primeros auxilios",
        Title = "¿Qué hacer ante una emergencia?",
        Summary = "Conocé la importancia de reconocer una emergencia, evaluar la seguridad de la escena y activar los servicios de respuesta.",
        Image = "/images/blog/PAB.jpg"
    },
    new
    {
        Category = "Reanimación",
        Title = "La importancia de la RCP temprana",
        Summary = "Descubrí por qué reconocer rápidamente un paro cardíaco e iniciar maniobras de reanimación puede marcar la diferencia.",
        Image = "/images/blog/rcp.jpg"
    },
    new
    {
        Category = "Atención prehospitalaria",
        Title = "Evaluación inicial del paciente traumatizado",
        Summary = "Explorá los principios de la valoración inicial y la identificación de amenazas inmediatas para la vida.",
        Image = "/images/blog/trauma.jpg"
    }
};

}

<!-- ==========================================
     PORTADA PRINCIPAL
     ========================================== -->

<section class="hero">
    <div class="container hero-grid">

        <div class="hero-copy">

            <span class="eyebrow">
                STATMEDICAL presenta
            </span>

            <img src="/images/home/logo-statmedical.png"
                 alt="Logotipo de STAT Medical"
                 class="hero-logo" />

            <h1>STAT Academy</h1>

            <p>
                Plataforma educativa y tienda profesional para cursos
                de salud, recursos médicos, blog educativo y aprendizaje
                guiado por tutores.
            </p>

            <div class="d-flex gap-2 flex-wrap">

                <a class="btn btn-primary"
                   asp-controller="Courses"
                   asp-action="Index">
                    Explorar cursos
                </a>

                <a class="btn btn-primary"
                   asp-controller="Products"
                   asp-action="Index">
                    Ver tienda
                </a>

            </div>

        </div>

        <!-- PANEL DE SERVICIOS -->

        <div class="hero-panel academy-services"
             aria-label="Servicios de STAT Academy">

            <div class="academy-services-header">

                <span class="academy-services-label">
                    CONOCÉ NUESTRA PLATAFORMA
                </span>

                <h2>Aprendé, preparate y crecé</h2>

                <p>
                    Formación y recursos para fortalecer
                    tus conocimientos profesionales.
                </p>

            </div>

            <div class="academy-service">

                <div class="academy-service-icon">
                    <span aria-hidden="true">✚</span>
                </div>

                <div class="academy-service-content">
                    <h3>Capacitación médica</h3>
                    <p>
                        Aprendizaje orientado a la práctica
                        y a la atención de emergencias.
                    </p>
                </div>

            </div>

            <div class="academy-service">

                <div class="academy-service-icon">
                    <span aria-hidden="true">▤</span>
                </div>

                <div class="academy-service-content">
                    <h3>Cursos especializados</h3>
                    <p>
                        Formación y actualización de
                        conocimientos profesionales.
                    </p>
                </div>

            </div>

            <div class="academy-service">

                <div class="academy-service-icon">
                    <span aria-hidden="true">▣</span>
                </div>

                <div class="academy-service-content">
                    <h3>Tienda profesional</h3>
                    <p>
                        Productos y recursos para apoyar
                        el aprendizaje y la práctica.
                    </p>
                </div>

            </div>

        </div>

    </div>
</section>

<!-- ==========================================
     CURSOS DESTACADOS
     ========================================== -->

<section class="section">
    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                Rutas destacadas
            </span>

            <h2>Cursos destacados</h2>

            <p>
                Programas diseñados por STATMEDICAL para
                aprendizaje práctico y profesional.
            </p>

        </div>

        <div class="card-grid three">

            @foreach (var course in featuredCourses)
            {
                <article class="card course-card">

                    <div class="visual">

                        <img src="@course.Image"
                             alt="@course.Title"
                             loading="lazy" />

                    </div>

                    <div class="card-body">

                        <span class="tag">
                            @course.Category
                        </span>

                        <h3>@course.Title</h3>

                        <p>@course.Description</p>

                        <a class="text-link"
                           asp-controller="Courses"
                           asp-action="Details"
                           asp-route-id="@course.Id">
                            Ver curso
                        </a>

                    </div>

                </article>
            }

        </div>

    </div>
</section>

<!-- ==========================================
     PRODUCTOS DESTACADOS
     ========================================== -->

<section class="section mission-section">
    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                Tienda
            </span>

            <h2>Productos destacados</h2>

            <p>
                Recursos e insumos seleccionados para
                prácticas, cursos y simulación.
            </p>

        </div>

        <div class="card-grid three">

            @foreach (var product in featuredProducts)
            {
                <article class="card product-card">

                    <div class="product-image">

                        <img src="@product.Image"
                             alt="@product.Name"
                             loading="lazy" />

                    </div>

                    <div class="product-content">

                        <span class="tag">
                            @product.Category
                        </span>

                        <h3>@product.Name</h3>

                        <p>@product.Description</p>

                        <span class="text-link">
                            Consultar disponibilidad
                        </span>

                    </div>

                </article>
            }

        </div>

    </div>
</section>

<!-- ==========================================
     ARTÍCULOS EDUCATIVOS
     ========================================== -->

<section class="section">
    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                Artículos educativos
            </span>

            <h2>Aprendizaje continuo</h2>

            <p>
                Artículos de prevención, salud
                y mejores prácticas.
            </p>

        </div>

        <div class="card-grid three">

         
@foreach (var post in featuredPosts)
{
    <article class="card blog-card">

        <div class="blog-image">
            <img src="@post.Image"
                 alt="@post.Title"
                 loading="lazy" />
        </div>

        <div class="blog-content">
            <span class="tag">@post.Category</span>

            <h3>@post.Title</h3>

            <p>@post.Summary</p>
        </div>

    </article>
}


        </div>

    </div>
</section>


<!-- ==========================================
     MENSAJE FINAL
     ========================================== -->

<section class="section">
    <div class="container">

        <div class="section-heading">

            <span class="eyebrow">
                Seguí aprendiendo
            </span>

            <h2>Tu preparación marca la diferencia</h2>

            <p>
                Explorá nuestros programas de formación
                y recursos para continuar desarrollando
                tus conocimientos en atención de emergencias.
            </p>

        </div>

        <a class="btn btn-primary"
           asp-controller="Courses"
           asp-action="Index">
            Explorar cursos
        </a>

    </div>
</section>
