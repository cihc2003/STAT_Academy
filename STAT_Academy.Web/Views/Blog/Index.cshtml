@using System.Security.Claims
@model List<STAT_Academy.Web.Models.Blog.BlogResponse>

@{
    ViewData["Title"] = "Blog";
    var usuarioId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var esAdmin = User.IsInRole("Admin");
}

<section class="page-hero blog-hero">
    <div class="container">
        <span class="eyebrow">Blog académico</span>
        <h1>Entradas del blog de STAT Academy</h1>
        <p>Noticias, publicaciones y contenido académico del equipo de STAT Academy.</p>

        @if (esAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">Nueva entrada</a>
        }
    </div>
</section>

<section class="section">
    <div class="container">
        @if (Model == null || !Model.Any())
        {
            <div class="info-block blog-empty">
                <span class="tag">Sin publicaciones</span>
                <h2>Aún no hay entradas en el blog</h2>
                <p>Cuando se publique contenido nuevo aparecerá aquí.</p>

                @if (esAdmin)
                {
                    <a asp-action="Create" class="btn btn-primary">Crear primera entrada</a>
                }
            </div>
        }
        else
        {
            <div class="card-grid two blog-grid">
                @foreach (var blog in Model)
                {
                    var esAutor = usuarioId == blog.FkAutor.ToString();
                    var documentos = blog.Documentos.Count();
                    var resumen = blog.Contenido.Length > 180
                        ? blog.Contenido[..180].TrimEnd() + "…"
                        : blog.Contenido;

                    <article class="card blog-card @(blog.Estado ? "" : "blog-card--inactiva")">
                        <a asp-action="Details" asp-route-id="@blog.Id" class="blog-card__visual"
                           aria-label="Leer @blog.Titulo">
                            @if (!string.IsNullOrEmpty(blog.ImagenPrincipal))
                            {
                                <img src="@blog.ImagenPrincipal" alt="" loading="lazy" />
                            }

                            @* Solo los administradores reciben entradas inactivas desde la API *@
                            @if (!blog.Estado)
                            {
                                <span class="tag blog-card__estado">Inactiva · solo administradores</span>
                            }
                        </a>

                        <div class="card-body blog-card__body">
                            <p class="blog-card__meta">
                                @(string.IsNullOrWhiteSpace(blog.Autor) ? $"Autor #{blog.FkAutor}" : blog.Autor)
                                · <time datetime="@blog.FechaCreacion.ToString("o")">@blog.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</time>
                                @if (documentos > 0)
                                {
                                    <span> · @documentos @(documentos == 1 ? "documento" : "documentos")</span>
                                }
                            </p>

                            <h3>@blog.Titulo</h3>

                            <p class="blog-card__excerpt">@resumen</p>

                            <div class="blog-card__actions">
                                <a asp-action="Details" asp-route-id="@blog.Id" class="text-link">Leer más</a>

                                @if (esAutor)
                                {
                                    <a asp-action="Edit" asp-route-id="@blog.Id" class="btn btn-outline-primary btn-sm">Editar</a>
                                }

                                @if (esAutor || esAdmin)
                                {
                                    if (blog.Estado)
                                    {
                                        <form asp-action="Desactivar" asp-route-id="@blog.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-danger btn-sm"
                                                    onclick="return confirm('¿Desactivar esta entrada? Dejará de verse para los clientes.');">
                                                Desactivar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activar" asp-route-id="@blog.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-outline-success btn-sm">Publicar</button>
                                        </form>
                                    }
                                }
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
