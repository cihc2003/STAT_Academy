@model List<STAT_Academy.Web.Models.Blog.BlogResponse>

@{
    ViewData["Title"] = "Blog";
    var esAdmin = User.IsInRole("Admin");
    var buscar = ViewData["Buscar"] as string;
    var total = ViewData["Total"] as int? ?? Model.Count;
    var filtrando = !string.IsNullOrWhiteSpace(buscar);

    // La entrada más reciente se destaca arriba (solo cuando no se está buscando).
    var destacada = !filtrando ? Model.FirstOrDefault() : null;
    var resto = destacada == null ? Model : Model.Skip(1).ToList();
}

<section class="encabezado-pagina">
    <div class="container encabezado-pagina__grid">
        <div>
            <h1>Blog</h1>
            <p>Artículos del equipo docente sobre salud, investigación y aprendizaje.</p>
        </div>

        <div class="encabezado-pagina__acciones">
            <form method="get" asp-action="Index" class="buscador" role="search" aria-label="Buscar en el blog" data-sin-carga>
                <label for="buscar" class="visually-hidden">Buscar artículos</label>
                @Html.Icono("buscar", "buscador__icono")
                <input id="buscar" name="buscar" type="search" class="form-control" value="@buscar" placeholder="Buscar artículos" autocomplete="off" maxlength="100" />
                <button type="submit" class="btn btn-primary">Buscar</button>
            </form>
            @if (esAdmin)
            {
                <a asp-action="Create" class="btn btn-secundario">@Html.Icono("mas")Nueva entrada</a>
            }
        </div>
    </div>
</section>

<section class="section section--compacta">
    <div class="container">
        @if (filtrando)
        {
            <div class="resultados" aria-live="polite">
                <p class="resultados__texto"><strong>@Model.Count</strong> de @total @(total == 1 ? "artículo" : "artículos") para «@buscar»</p>
                <a class="chip" asp-action="Index">«@buscar» @Html.Icono("cerrar", "icono--sm")<span class="visually-hidden">Quitar búsqueda</span></a>
            </div>
        }

        @if (Model.Count == 0)
        {
            <div class="vacio">
                <span class="vacio__icono">@Html.Icono("articulo", "icono--lg")</span>
                <h2>@(filtrando ? "No hay artículos con esa búsqueda" : "Todavía no hay artículos")</h2>
                <p>@(filtrando ? "Pruebe con otras palabras o revise la ortografía." : "Los artículos nuevos aparecen aquí en cuanto se publican.")</p>
                @if (filtrando)
                {
                    <a asp-action="Index" class="btn btn-secundario">Ver todos los artículos</a>
                }
                else if (esAdmin)
                {
                    <a asp-action="Create" class="btn btn-primary">Escribir la primera entrada</a>
                }
            </div>
        }
        else
        {
            @if (destacada != null)
            {
                var autor = string.IsNullOrWhiteSpace(destacada.Autor) ? "Equipo STAT Academy" : destacada.Autor;

                <article class="blog-destacada @(destacada.Estado ? "" : "tarjeta-item--apagada")" aria-labelledby="blog-destacada-titulo">
                    <div class="blog-destacada__portada tarjeta-item__media">
                        @if (!string.IsNullOrEmpty(destacada.ImagenPrincipal))
                        {
                            <img src="@destacada.ImagenPrincipal" alt="" />
                        }
                        else
                        {
                            <span class="tarjeta-item__sin-imagen">@Html.Icono("articulo", "icono--xl")</span>
                        }
                    </div>
                    <div class="blog-destacada__cuerpo">
                        @if (destacada.Estado)
                        {
                            <span class="etiqueta">Lo más reciente</span>
                        }
                        else
                        {
                            <span class="estado estado--neutro">Oculta: solo la ven los administradores</span>
                        }
                        <h2 id="blog-destacada-titulo"><a asp-action="Details" asp-route-id="@destacada.Id">@destacada.Titulo</a></h2>
                        <p class="blog-destacada__resumen">@destacada.Resumen</p>
                        <ul class="datos-icono datos-icono--fila">
                            <li>@Html.Icono("usuario")<span>@autor</span></li>
                            <li>@Html.Icono("calendario")<time datetime="@destacada.FechaCreacion.ToString("o")">@Formato.Fecha(destacada.FechaCreacion)</time></li>
                            <li>@Html.Icono("reloj")<span>@destacada.MinutosLectura min de lectura</span></li>
                        </ul>
                        <div class="acciones-fila">
                            <a asp-action="Details" asp-route-id="@destacada.Id" class="btn btn-primary">Leer el artículo</a>
                            <partial name="_BlogAcciones" model="destacada" />
                        </div>
                    </div>
                </article>
            }

            @if (resto.Any())
            {
                @if (destacada != null)
                {
                    <h2 class="blog-listado__titulo">Más artículos</h2>
                }

                <div class="rejilla rejilla--amplia">
                    @foreach (var blog in resto)
                    {
                        <div class="blog-rejilla__item">
                            <partial name="_BlogTarjeta" model="blog" />
                            <div class="blog-rejilla__acciones">
                                <partial name="_BlogAcciones" model="blog" />
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</section>
