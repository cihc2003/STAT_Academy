@model STAT_Academy.Web.Models.BlogViewModel

<section class="section">
    <div class="container">
        <a class="text-link" asp-controller="Blog" asp-action="Index">&larr; Volver al blog</a>

        <div class="section-heading mt-3">
            <span class="eyebrow">@Model.fecha_creacion.ToString("dd/MM/yyyy")</span>
            <h1>@Model.titulo</h1>
            <p>Por @(string.IsNullOrWhiteSpace(Model.Autor) ? "STAT Academy" : Model.Autor)</p>
        </div>

        <article class="card p-4">
            <p style="white-space: pre-line;">@Model.contenido</p>
        </article>
    </div>
</section>