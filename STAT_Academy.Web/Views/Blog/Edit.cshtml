@model STAT_Academy.Web.Models.BlogViewModel


<h1>Editar Blog</h1>


<form asp-action="Edit" method="post">


    <input type="hidden"
           asp-for="id" />


    <input asp-for="titulo"
           class="form-control" />


    <textarea asp-for="contenido"
              class="form-control"></textarea>


    <input type="hidden"
           asp-for="estado" />


    <button class="btn btn-primary">
        Actualizar
    </button>


</form>