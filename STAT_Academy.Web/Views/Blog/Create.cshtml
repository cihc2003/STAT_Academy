@using STAT_Academy.Web.Models.Blog
@model CreateBlogViewModel

@{
    ViewData["Title"] = "Crear entrada";
}

<section class="page-hero">
    <div class="container">
        <span class="eyebrow">Blog académico</span>
        <h1>Crear nueva entrada</h1>
        <p>Usted quedará como autor y será la única persona que pueda editarla.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        <form asp-action="Create" method="post" enctype="multipart/form-data" class="card blog-form card-body">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="form-group mb-3">
                <label asp-for="Titulo" class="form-label"></label>
                <input asp-for="Titulo" class="form-control" maxlength="150" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Contenido" class="form-label"></label>
                <textarea asp-for="Contenido" class="form-control" rows="10"></textarea>
                <span asp-validation-for="Contenido" class="text-danger"></span>
            </div>

            <div class="form-group mb-4">
                <label asp-for="Archivos" class="form-label"></label>
                <input asp-for="Archivos" type="file" class="form-control" multiple
                       accept="@BlogArchivoLimites.Accept" data-blog-archivos />
                <div class="form-text">@BlogArchivoLimites.Ayuda</div>
                <ul class="blog-seleccion" data-blog-seleccion hidden></ul>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">Publicar</button>
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_BlogArchivosScript" />
}
