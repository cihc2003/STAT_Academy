@using STAT_Academy.Web.Models.Blog
@model CreateBlogViewModel

@{
    ViewData["Title"] = "Nueva entrada";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css"
          integrity="sha384-ecIckRi4QlKYya/FQUbBUjS4qp65jF/J87Guw5uzTbO1C1Jfa/6kYmd6dXUF6D7i" crossorigin="anonymous" />
}

<section class="section">
    <div class="container blog-editor-pagina">
        <a asp-action="Index" class="text-link">&larr; Volver al blog</a>

        <div class="section-heading mt-3">
            <span class="eyebrow">Blog académico</span>
            <h1>Nueva entrada</h1>
            <p>Usted quedará como autor y será la única persona que pueda editarla.</p>
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" class="card blog-form card-body">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Titulo" class="form-label fw-bold"></label>
                <input asp-for="Titulo" class="form-control form-control-lg blog-titulo-input" maxlength="150"
                       placeholder="Un título claro y llamativo" />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label for="portada" class="form-label fw-bold">Imagen de portada</label>
                <input id="portada" name="Archivos" type="file" class="form-control" accept=".jpg,.jpeg,.png,.gif,.webp" data-blog-archivos />
                <div class="form-text">Aparece en el listado del blog y arriba de la entrada. JPG, PNG, GIF o WEBP de hasta 5 MB.</div>
                <ul class="blog-seleccion" data-blog-seleccion hidden></ul>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold">Contenido</label>
                <partial name="_EditorContenido" model="Model.Contenido" />
                <span asp-validation-for="Contenido" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label for="documentos" class="form-label fw-bold">Documentos adjuntos <span class="fw-normal text-muted">(opcional)</span></label>
                <input id="documentos" name="Archivos" type="file" class="form-control" multiple
                       accept=".pdf,.doc,.docx,.xlsx,.pptx,.txt,.csv" data-blog-archivos />
                <div class="form-text">PDF, Word, Excel, PowerPoint, TXT o CSV de hasta 10 MB. Se listan al final de la entrada para descargar.</div>
                <ul class="blog-seleccion" data-blog-seleccion hidden></ul>
            </div>

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary btn-lg">Publicar entrada</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_BlogArchivosScript" />
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"
            integrity="sha384-utBUCeG4SYaCm4m7GQZYr8Hy8Fpy3V4KGjBZaf4WTKOcwhCYpt/0PfeEe3HNlwx8" crossorigin="anonymous"></script>
    <script src="~/js/blog-editor.js" asp-append-version="true"></script>
}
