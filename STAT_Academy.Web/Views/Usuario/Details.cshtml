@model STAT_Academy.Web.Models.Usuarios.UsuarioResponse

@{
    ViewData["Title"] = "Detalle de usuario";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section class="card p-4">
        <span class="eyebrow">Administración</span>
        <h1>Detalle de usuario</h1>

        <div class="row g-3 mt-2">
            <div class="col-md-6 form-group">
                <label>Nombre</label>
                <input class="form-control" value="@Model.nombre" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Correo</label>
                <input class="form-control" value="@Model.email" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Tipo</label>
                <input class="form-control" value="@ObtenerTipo(Model.fk_Tipo_Usuario)" readonly />
            </div>

            <div class="col-md-6 form-group">
                <label>Estado</label>
                <input class="form-control" value="@(Model.activo ? "Activo" : "Inactivo")" readonly />
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
            <a class="btn btn-outline-primary" asp-action="UserForm" asp-route-id="@Model.id">Editar</a>

            @if (Model.activo)
            {
                <form asp-action="ToggleUser" asp-route-id="@Model.id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-danger" type="submit">Desactivar</button>
                </form>
            }
        </div>
    </section>
</div>

@functions {
    private static string ObtenerTipo(int tipo)
    {
        return tipo switch
        {
            1 => "Admin",
            2 => "Tutor",
            3 => "Cliente",
            _ => "Usuario"
        };
    }
}