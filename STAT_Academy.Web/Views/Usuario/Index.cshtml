@model IEnumerable<STAT_Academy.Web.Models.Usuarios.UsuarioResponse>

@{
    ViewData["Title"] = "Usuarios";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="eyebrow">Administración</span>
                <h1>Usuarios</h1>
            </div>

            <a class="btn btn-primary" asp-action="UserForm">Nuevo usuario</a>
        </div>

        <form class="row g-2 mb-3" method="get" asp-action="Index">
            <div class="col-md-4">
                <input class="form-control" name="search" value="@ViewBag.Search" placeholder="Buscar por nombre o correo" />
            </div>

            <div class="col-md-3">
                <select class="form-select" name="tipo" asp-items="ViewBag.Tipos">
                    <option value="">Todos los tipos</option>
                </select>
            </div>

            <div class="col-md-3">
                <select class="form-select" name="active">
                    <option value="">Todos los estados</option>
                    <option value="true" selected="@(ViewBag.Active == true ? "selected" : null)">Activos</option>
                    <option value="false" selected="@(ViewBag.Active == false ? "selected" : null)">Inactivos</option>
                </select>
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Filtrar</button>
            </div>
        </form>

        <div class="table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Correo</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th class="text-end"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No hay usuarios registrados.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.nombre</td>
                                <td>@item.email</td>
                                <td><span class="status-pill">@ObtenerTipo(item.fk_Tipo_Usuario)</span></td>
                                <td><span class="status-pill">@(item.activo ? "Activo" : "Inactivo")</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.id">Ver</a>
                                    <a class="btn btn-sm btn-outline-secondary" asp-action="UserForm" asp-route-id="@item.id">Editar</a>

                                    @if (item.activo)
                                    {
                                        <form asp-action="ToggleUser" asp-route-id="@item.id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Desactivar</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@functions {
    private static string ObtenerTipo(int tipo)
    {
        return tipo switch
        {
            1 => "Admin",
            2 => "Tutor",
            3 => "Cliente",
            _ => "Usuario"
        };
    }
}