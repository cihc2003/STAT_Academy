@model STAT_Academy.Web.Models.Carrito.CompraResponse

@{
    ViewData["Title"] = $"Compra #{Model.facturaId}";
}

<section class="section">
    <div class="container" style="max-width: 760px;">
        <div class="section-heading">
            <span class="eyebrow">Comprobante</span>
            <h1>Compra #@Model.facturaId</h1>
            <p>
                @Model.fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ·
                <span class="status-pill @(Model.pagada ? "tutor-pill--ok" : "tutor-pill--alerta")">@(Model.pagada ? "Pagada" : "Pendiente de pago")</span>
            </p>
        </div>

        <div class="card p-4">
            <ul class="list-unstyled mb-0">
                @foreach (var l in Model.lineas)
                {
                    <li class="d-flex justify-content-between gap-3 py-2 border-bottom">
                        <span>
                            @l.nombre <span class="text-muted">× @l.cantidad</span>
                            <div class="small text-muted">@Formato.Colones(l.precio_unitario) c/u</div>
                        </span>
                        <strong class="text-nowrap">@Formato.Colones(l.subtotal)</strong>
                    </li>
                }
            </ul>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="h5 mb-0">Total</span>
                <strong class="h4 mb-0">@Formato.Colones(Model.total)</strong>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mt-4">
            <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Seguir comprando</a>
            <button class="btn btn-outline-secondary" type="button" onclick="window.print()">Imprimir comprobante</button>
        </div>
    </div>
</section>
