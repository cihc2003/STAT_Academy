@model STAT_Academy.Web.Models.Carrito.CarritoResponse

@{
    ViewData["Title"] = "Finalizar compra";
}

<section class="section">
    <div class="container" style="max-width: 860px;">
        <a class="text-link" asp-action="Index">&larr; Volver al carrito</a>

        <div class="section-heading mt-3">
            <span class="eyebrow">Pago</span>
            <h1>Confirmar compra</h1>
            <p>Revisa tu pedido. Al confirmar, se registra la compra, se reservan las unidades y te enviamos el comprobante por correo.</p>
        </div>

        <div class="card p-4">
            <h2 class="h5">Resumen del pedido</h2>

            <ul class="list-unstyled mt-3 mb-0">
                @foreach (var item in Model.items)
                {
                    <li class="d-flex justify-content-between gap-3 py-2 border-bottom">
                        <span>
                            @item.nombre
                            <span class="text-muted">× @item.cantidad</span>
                            <div class="small text-muted">@Formato.Colones(item.precio_unitario) c/u</div>
                        </span>
                        <strong class="text-nowrap">@Formato.Colones(item.subtotal)</strong>
                    </li>
                }
            </ul>

            <div class="d-flex justify-content-between align-items-center mt-3">
                <span class="h5 mb-0">Total</span>
                <strong class="h4 mb-0">@Formato.Colones(Model.total)</strong>
            </div>

            @* El pago se hace fuera de la plataforma (SINPE Móvil o transferencia) y se verifica con el comprobante. *@
            <div class="alert alert-info mt-4 mb-0" role="note">
                <strong>Pago por SINPE Móvil o transferencia.</strong> Después de confirmar verás el número
                de SINPE y la cuenta bancaria. Cuando pagues, sube el comprobante en
                <em>Mis facturas y pagos</em>; te avisaremos por correo cuando lo verifiquemos.
            </div>

            <form asp-action="Confirmar" method="post" class="d-flex flex-wrap gap-2 mt-4"
                  onsubmit="this.querySelector('button[type=submit]').disabled = true;">
                <button class="btn btn-primary" type="submit">Confirmar compra · @Formato.Colones(Model.total)</button>
                <a class="btn btn-outline-secondary" asp-action="Index">Volver al carrito</a>
            </form>
        </div>
    </div>
</section>
