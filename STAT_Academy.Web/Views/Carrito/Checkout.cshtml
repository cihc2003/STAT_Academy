@model STAT_Academy.Web.Models.Carrito.CarritoResponse

@{
    ViewData["Title"] = "Confirmar compra";
}

<section class="section section--compacta">
    <div class="container contenedor-lectura">
        <a class="enlace-volver" asp-action="Index">@Html.Icono("flecha-izquierda", "icono--sm")Carrito</a>

        <div class="section-heading">
            <h1>Confirmar compra</h1>
            <p>Revise su pedido. Al confirmar, se registra la compra, se reservan las unidades y le enviamos el comprobante por correo.</p>
        </div>

        <div class="panel-tarjeta">
            <h2 class="panel-tarjeta__titulo">Resumen del pedido</h2>

            <ul class="lista-pedido">
                @foreach (var item in Model.items)
                {
                    <li>
                        <span>
                            <strong>@item.nombre</strong>
                            <span class="lista-pedido__detalle">@item.cantidad × @Formato.Colones(item.precio_unitario)</span>
                        </span>
                        <strong class="text-nowrap">@Formato.Colones(item.subtotal)</strong>
                    </li>
                }
            </ul>

            <div class="lista-pedido__total">
                <span>Total</span>
                <strong>@Formato.Colones(Model.total)</strong>
            </div>

            @* El pago se hace fuera de la plataforma (SINPE Móvil o transferencia) y se verifica con el comprobante. *@
            <aviso tipo="info" titulo="Pago por SINPE Móvil o transferencia" anunciar="false">
                Después de confirmar verá el número de SINPE y la cuenta bancaria. Cuando pague, suba el comprobante en
                <em>Facturas y pedidos</em> (menú de su perfil); le avisaremos por correo cuando lo verifiquemos.
            </aviso>

            <form asp-action="Confirmar" method="post" class="acciones-fila" data-un-solo-envio>
                <button class="btn btn-primary btn-lg" type="submit">Confirmar compra por @Formato.Colones(Model.total)</button>
                <a class="btn btn-secundario btn-lg" asp-action="Index">Volver al carrito</a>
            </form>
        </div>
    </div>
</section>
