@model Course
@{ ViewData["Title"] = Model.Title; }
<section class="section"><div class="container">
    <div class="card p-4">
        <span class="tag">@Model.Category</span>
        <h1>@Model.Title</h1>
        <p class="text-muted">@Model.Description</p>
        <p><strong>Duración:</strong> @Model.DurationWeeks semanas</p>
        <p><strong>Tutor:</strong> @(Model.Tutor?.FullName ?? "Por asignar")</p>
        <h2>@Model.Price.ToString("C")</h2>
        @if (User.IsInRole(STAT_Academy.Web.Data.SeedData.StudentRole)) {
            <form asp-action="Enroll" method="post"><input type="hidden" name="id" value="@Model.Id"><button class="btn btn-primary">Solicitar matrícula</button></form>
        } else {
            <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Ingresar para matricularme</a>
        }
    </div>
</div></section>
