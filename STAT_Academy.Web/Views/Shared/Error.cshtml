@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="section">
    <div class="container">
        <div class="card p-4">
            <h1 class="text-danger">Error</h1>
            <h2 class="text-danger">Ocurrió un error al procesar la solicitud.</h2>
            @if (Model.ShowRequestId)
            {
                <p><strong>Identificador de solicitud:</strong> <code>@Model.RequestId</code></p>
            }
            <h3>Modo de desarrollo</h3>
            <p>Al usar el entorno de desarrollo se muestra información más detallada sobre el error.</p>
            <p><strong>El entorno de desarrollo no debe estar activo en producción.</strong> Puede mostrar información sensible a los usuarios finales.</p>
        </div>
    </div>
</section>
