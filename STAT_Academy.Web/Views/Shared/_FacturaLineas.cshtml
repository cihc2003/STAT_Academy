@model STAT_Academy.Web.Models.Facturas.FacturaDetalle
@* Líneas y total de una factura (lo usan "Mis facturas" y el panel de administración). *@

<ul class="list-unstyled mb-0">
    @foreach (var l in Model.lineas)
    {
        <li class="d-flex justify-content-between gap-3 py-2 border-bottom">
            <span>
                @l.nombre
                @if (l.tipo != "CURSO")
                {
                    <span class="text-muted">× @l.cantidad</span>
                }
                <div class="small text-muted">@Formato.Colones(l.precio_unitario)@(l.tipo == "CURSO" ? "" : " c/u")</div>
            </span>
            <strong class="text-nowrap">@Formato.Colones(l.subtotal)</strong>
        </li>
    }
</ul>

<div class="d-flex justify-content-between align-items-center mt-3">
    <span class="h5 mb-0">Total</span>
    <strong class="h4 mb-0">@Formato.Colones(Model.total)</strong>
</div>
