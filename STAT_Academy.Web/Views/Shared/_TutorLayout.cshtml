@{
    // Layout de las páginas del panel del tutor: estructura de panel a página completa
    // (menú lateral de altura completa + contenido a todo el ancho).
    // - Admin: con el menú de Administración (el panel del tutor es una sección más).
    // - Tutor: con su propio menú (Mis cursos y sus cursos asignados).
    Layout = "_Layout";
}

<div class="container admin-shell admin-shell--tutor">
    @if (User.IsInRole("Admin"))
    {
        <partial name="_AdminNav" />
    }
    else
    {
        <partial name="_TutorNav" />
    }
    <div class="admin-contenido">
        @RenderBody()
    </div>
</div>

@section Styles {
    @await RenderSectionAsync("Styles", required: false)
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
