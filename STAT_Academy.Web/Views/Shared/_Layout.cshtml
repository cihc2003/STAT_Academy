@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var esAdmin = User.IsInRole("Admin");
    var esTutor = User.IsInRole("Tutor");
    var esCliente = User.IsInRole("Cliente");

    // Marca el enlace de la sección actual (aria-current para lectores de pantalla).
    string Activo(string c, string? a = null) =>
        controlador == c && (a == null || accion == a) ? "active" : "";
    string? Actual(string c, string? a = null) =>
        controlador == c && (a == null || accion == a) ? "page" : null;

    var nombre = User.Identity?.Name ?? "";
    var inicial = string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim()[..1].ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | STAT Academy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>

    <header class="site-header">
        <nav class="navbar navbar-expand-lg container menu" aria-label="Navegación principal">
            <a class="brand" asp-controller="Home" asp-action="Index">STAT Academy</a>

            @* Móvil y tablet: botón hamburguesa. Escritorio: barra horizontal. *@
            <button class="navbar-toggler menu-toggle" type="button"
                    data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú">
                <span class="menu-toggle__icono" aria-hidden="true"><span></span><span></span><span></span></span>
                <span class="menu-toggle__texto">Menú</span>
            </button>

            <div id="mainNav" class="collapse navbar-collapse menu-panel">
                <ul class="navbar-nav menu-links me-lg-auto ms-lg-4">
                    <li class="nav-item"><a class="nav-link @Activo("Home", "Index")" aria-current="@Actual("Home", "Index")" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li class="nav-item"><a class="nav-link @Activo("Curso", "Index")" aria-current="@Actual("Curso", "Index")" asp-controller="Curso" asp-action="Index">Cursos</a></li>
                    <li class="nav-item"><a class="nav-link @Activo("Products")" aria-current="@Actual("Products")" asp-controller="Products" asp-action="Index">Tienda</a></li>
                    <li class="nav-item"><a class="nav-link @Activo("Blog")" aria-current="@Actual("Blog")" asp-controller="Blog" asp-action="Index">Blog</a></li>
                    <li class="nav-item"><a class="nav-link @Activo("Home", "Contacto")" aria-current="@Actual("Home", "Contacto")" asp-controller="Home" asp-action="Contacto">Contacto</a></li>
                </ul>

                <ul class="navbar-nav menu-acciones align-items-lg-center">
                    @* Acceso directo a la zona de trabajo de cada rol *@
                    @if (esAdmin)
                    {
                        <li class="nav-item"><a class="nav-link menu-rol @Activo("Admin")" asp-controller="Admin" asp-action="Dashboard">Administración</a></li>
                    }
                    @if (esTutor || esAdmin)
                    {
                        <li class="nav-item"><a class="nav-link menu-rol @Activo("Tutor")" asp-controller="Tutor" asp-action="Index">Panel del tutor</a></li>
                    }
                    @if (esCliente)
                    {
                        <li class="nav-item"><a class="nav-link menu-rol @Activo("Curso", "MisCursos")" asp-controller="Curso" asp-action="MisCursos">Mis cursos</a></li>
                    }

                    @if (!isAuthenticated || esCliente)
                    {
                        <li class="nav-item">
                            <a class="nav-link menu-carrito @Activo("Carrito")" asp-controller="Carrito" asp-action="Index" aria-label="Carrito">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="21" r="1" /><circle cx="20" cy="21" r="1" /><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6" /></svg>
                                <span class="d-lg-none">Carrito</span>
                            </a>
                        </li>
                    }

                    @if (isAuthenticated)
                    {
                        <li class="nav-item dropdown">
                            <button class="nav-link dropdown-toggle menu-usuario" type="button"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="menu-usuario__avatar" aria-hidden="true">@inicial</span>
                                <span class="menu-usuario__nombre">@nombre</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end menu-dropdown">
                                <li><span class="dropdown-item-text small text-muted">@(esAdmin ? "Administrador" : esTutor ? "Tutor" : "Estudiante")</span></li>
                                <li><a class="dropdown-item" asp-controller="Cuenta" asp-action="CambiarContrasena">Cambiar contraseña</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <form asp-controller="Cuenta" asp-action="Logout" method="post">
                                        <button class="dropdown-item text-danger" type="submit">Cerrar sesión</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item"><a class="nav-link" asp-controller="Cuenta" asp-action="Login">Ingresar</a></li>
                        <li class="nav-item"><a class="btn btn-primary menu-registro" asp-controller="Cuenta" asp-action="Registrar">Registrarse</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main role="main" id="contenido" tabindex="-1">
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3">
                <div class="alert alert-success">@success</div>
            </div>
        }

        @if (TempData["Error"] is string error)
        {
            <div class="container mt-3">
                <div class="alert alert-danger">@error</div>
            </div>
        }

        @RenderBody()
    </main>

    @* Pantalla de carga: la muestra site.js al navegar o enviar formularios (las páginas esperan a la API). *@
    <div id="pantalla-carga" class="pantalla-carga" role="status" aria-live="polite" hidden>
        <div class="pantalla-carga__caja">
            <span class="pantalla-carga__spinner" aria-hidden="true"></span>
            <span class="pantalla-carga__texto">Cargando…</span>
        </div>
    </div>

    <footer class="site-footer">
        <div class="container footer-grid">
            <p>&copy; 2026 STATMEDICAL | STAT Academy. Todos los derechos reservados.</p>
            <a asp-controller="Curso" asp-action="Index">
                Explorar formación
            </a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>