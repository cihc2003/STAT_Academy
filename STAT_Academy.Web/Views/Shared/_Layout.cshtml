@using STAT_Academy.Web.Data
@{
    var currentPage = ViewData["Page"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] | STAT Academy</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg container" aria-label="Navegación principal">
            <a class="brand" asp-controller="Home" asp-action="Index">STAT Academy</a>
            <button class="navbar-toggler nav-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Abrir menú">
                <span>Menú</span>
            </button>
            <div id="mainNav" class="collapse navbar-collapse">
                <ul class="navbar-nav nav-links ms-auto align-items-lg-center">
                    <li><a class="@(currentPage == "Inicio" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a></li>
                    <li><a asp-controller="Courses" asp-action="Index">Cursos</a></li>
                    <li><a asp-controller="Products" asp-action="Index">Tienda</a></li>
                    <li><a asp-controller="Blog" asp-action="Index">Artículos</a></li>
                    <li><a asp-controller="Home" asp-action="Contacto">Contacto</a></li>

                    <li><a asp-controller="Admin" asp-action="Dashboard">Administración</a></li>
                    <li><a asp-controller="Tutor" asp-action="Courses">Tutor</a></li>
                    <li><a asp-controller="Student" asp-action="MisCursos">Mis cursos</a></li>
                    <li><a asp-controller="Cart" asp-action="Index">Carrito</a></li>
            @*
                    @if (User.IsInRole(SeedData.AdminRole))
                    {
                        <li><a asp-controller="Admin" asp-action="Dashboard">Administración</a></li>
                    }
                    
                    @if (User.IsInRole(SeedData.TutorRole))
                    {
                        <li><a asp-controller="Tutor" asp-action="Courses">Tutor</a></li>
                    }
                    @if (User.IsInRole(SeedData.StudentRole))
                    {
                        <li><a asp-controller="Student" asp-action="MisCursos">Mis cursos</a></li>
                        <li><a asp-controller="Cart" asp-action="Index">Carrito</a></li>

                    }
            *@
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button class="nav-button" type="submit">Salir</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li><a asp-controller="Account" asp-action="Login">Ingresar</a></li>
                        <li><a class="btn-nav" asp-controller="Account" asp-action="Register">Registro</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <main role="main">
        @if (TempData["Success"] is string success)
        {
            <div class="container mt-3"><div class="alert alert-success">@success</div></div>
        }
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-grid">
            <p>(c) 2026 STATMEDICAL | STAT Academy. Todos los derechos reservados.</p>
            <a asp-controller="Courses" asp-action="Index">Explorar formación</a>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
