@{
    // Menú lateral del perfil, con el mismo diseño que el de Administración (.admin-sidebar):
    // Mis datos, Contraseña y, para clientes, Facturas y pedidos.
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString();
    var accion = ViewContext.RouteData.Values["action"]?.ToString();
    var esCliente = User.IsInRole("Cliente");

    var nombre = User.Identity?.Name ?? "";
    var inicial = string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim()[..1].ToUpperInvariant();
    var correo = User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";

    var opciones = new List<(string grupo, string controlador, string accion, string texto, string icono)>
    {
        ("Mi cuenta", "Perfil", "Index", "Mis datos", "<circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21a8 8 0 0 1 16 0\"/>"),
        ("Mi cuenta", "Perfil", "Contrasena", "Contraseña", "<rect x=\"4\" y=\"11\" width=\"16\" height=\"10\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/>")
    };
    if (esCliente)
    {
        opciones.Add(("Compras", "Facturas", "Index", "Facturas y pedidos", "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M8 13h8\"/><path d=\"M8 17h5\"/>"));
    }
}

<aside class="admin-sidebar" aria-label="Mi cuenta">
    <div class="admin-sidebar__marca">
        <span class="admin-sidebar__logo admin-sidebar__logo--usuario" aria-hidden="true">@inicial</span>
        <div class="admin-sidebar__usuario">
            <strong>@nombre</strong>
            <small>@correo</small>
        </div>
    </div>

    <nav class="admin-sidebar__nav">
        @foreach (var grupo in opciones.GroupBy(o => o.grupo))
        {
            <p class="admin-sidebar__grupo">@grupo.Key</p>
            @foreach (var o in grupo)
            {
                var activo = controlador == o.controlador && accion == o.accion;
                <a asp-controller="@o.controlador" asp-action="@o.accion"
                   class="admin-sidebar__link @(activo ? "admin-sidebar__link--activo" : "")"
                   aria-current="@(activo ? "page" : null)">
                    <svg class="admin-sidebar__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(o.icono)</svg>
                    <span>@o.texto</span>
                </a>
            }
        }
    </nav>

    <a class="admin-sidebar__sitio" asp-controller="Home" asp-action="Index">
        <svg class="admin-sidebar__icono" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
        <span>Volver al sitio</span>
    </a>
</aside>
