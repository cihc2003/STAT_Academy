@model IEnumerable<CartItemViewModel>
@{ ViewData["Title"] = "Carrito"; var total = Model.Sum(x => x.Subtotal); }
<section class="section"><div class="container">
    <h1>Carrito de compras</h1>
    <div class="table-card"><table class="table align-middle mb-0"><thead><tr><th>Producto</th><th>Cantidad</th><th>Subtotal</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Quantity</td><td>@item.Subtotal.ToString("C")</td><td class="text-end"><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@item.ProductId"><button class="btn btn-sm btn-outline-danger">Quitar</button></form></td></tr> }
    </tbody></table></div>
    <div class="card p-4 mt-3 d-flex flex-md-row justify-content-between align-items-md-center"><h2>Total: @total.ToString("C")</h2><form asp-action="Confirm" method="post"><button class="btn btn-primary" disabled="@(!Model.Any())">Confirmar pedido</button></form></div>
</div></section>
