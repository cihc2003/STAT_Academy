@model STAT_Academy.Web.Models.Perfil.FacturaPagina

@{
    ViewData["Title"] = "Facturas y pedidos";
    var porPagar = Model.porPagar;
    var ordenes = new (string valor, string texto)[]
    {
        ("recientes", "Más recientes primero"),
        ("antiguas", "Más antiguas primero"),
        ("total_desc", "Mayor total"),
        ("total", "Menor total")
    };
}

<div class="container admin-shell admin-shell--perfil">
    <partial name="_PerfilNav" />

    <div class="perfil-contenido">
        <div class="perfil-encabezado">
            <span class="eyebrow">Mi cuenta</span>
            <h1>Facturas y pedidos</h1>
            <p>Consulta tus compras, el estado de cada pago y envía los comprobantes de SINPE Móvil o transferencia.</p>
        </div>

        @if (porPagar > 0)
        {
            <div class="alert alert-warning" role="status">
                Tienes <strong>@porPagar @(porPagar == 1 ? "compra pendiente" : "compras pendientes")</strong> de pago.
                Abre la factura para ver los datos de pago y subir el comprobante.
            </div>
        }

        @if (Model.total == 0)
        {
            <div class="card p-4 text-center">
                <p class="mb-3">Todavía no tienes compras registradas.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <a class="btn btn-primary" asp-controller="Products" asp-action="Index">Ir a la tienda</a>
                    <a class="btn btn-outline-primary" asp-controller="Curso" asp-action="Index">Ver cursos</a>
                </div>
            </div>
        }
        else
        {
            <form method="get" asp-action="Index" class="perfil-orden">
                @if (Model.tamano != 10)
                {
                    <input type="hidden" name="tamano" value="@Model.tamano" />
                }
                <label class="small text-muted" for="orden-facturas">Ordenar por</label>
                <select class="form-select form-select-sm" id="orden-facturas" name="orden" data-autoenviar>
                    @foreach (var (valor, texto) in ordenes)
                    {
                        <option value="@valor" selected="@(valor == Model.orden)">@texto</option>
                    }
                </select>
                <noscript><button class="btn btn-sm btn-outline-secondary" type="submit">Aplicar</button></noscript>
            </form>

            <div class="table-card">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Compra</th>
                            <th>Detalle</th>
                            <th class="text-end">Total</th>
                            <th>Estado</th>
                            <th><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model.items)
                        {
                            var (texto, clase) = EstadoPago.Factura(f.estado);
                            var pendiente = f.estado is "PENDIENTE_PAGO" or "RECHAZADA";
                            <tr>
                                <td>
                                    <strong>#@f.id</strong>
                                    <div class="text-muted small">@EstadoPago.Fecha(f.fecha)</div>
                                </td>
                                <td>@f.descripcion</td>
                                <td class="text-end text-nowrap">@Formato.Colones(f.total)</td>
                                <td><span class="status-pill @clase">@texto</span></td>
                                <td class="text-end">
                                    <a class="btn btn-sm @(pendiente ? "btn-primary" : "btn-outline-primary")"
                                       asp-action="Detalle" asp-route-id="@f.id">
                                        @(pendiente ? "Pagar" : "Ver")
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_PanelPaginacion" model="ViewBag.Paginacion" />
        }
    </div>
</div>
