@model STAT_Academy.Web.Models.Admin.ProductoFormViewModel

@{
    var esEdicion = Model.id != null;
    ViewData["Title"] = esEdicion ? "Editar producto" : "Nuevo producto";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section class="card p-4">
        <span class="eyebrow">Administración</span>
        <h1>@(esEdicion ? "Editar producto" : "Nuevo producto")</h1>

        <div asp-validation-summary="All" class="text-danger mt-2"></div>

        <form asp-action="ProductForm" method="post" enctype="multipart/form-data" class="row g-3 mt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="id" />

            <div class="col-md-6 form-group">
                <label asp-for="nombre">Nombre</label>
                <input class="form-control" asp-for="nombre" />
                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>

            <div class="col-md-6 form-group">
                <label asp-for="categoria">Categoría</label>
                <input class="form-control" asp-for="categoria" />
                <span asp-validation-for="categoria" class="text-danger"></span>
            </div>

            <div class="col-12 form-group">
                <label asp-for="descripcion">Descripción</label>
                <textarea class="form-control" asp-for="descripcion" rows="3"></textarea>
                <span asp-validation-for="descripcion" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group">
                <label asp-for="precio_base">Precio</label>
                <div class="input-group">
                    <span class="input-group-text">₡</span>
                    <input class="form-control" asp-for="precio_base" type="number" step="0.01" min="0.01" inputmode="decimal" />
                </div>
                <span asp-validation-for="precio_base" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group">
                <label asp-for="stock">Existencias</label>
                <input class="form-control" asp-for="stock" type="number" min="0" step="1" inputmode="numeric" />
                <span asp-validation-for="stock" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group">
                <label asp-for="min_stock">Stock mínimo</label>
                <input class="form-control" asp-for="min_stock" type="number" min="0" step="1" inputmode="numeric" />
                <div class="form-text">Se avisa a los administradores cuando las existencias llegan a este número o menos.</div>
                <span asp-validation-for="min_stock" class="text-danger"></span>
            </div>

            <div class="col-md-6 form-group">
                <label asp-for="fk_proveedor">Proveedor</label>
                <select class="form-select" asp-for="fk_proveedor">
                    <option value="">Selecciona un proveedor...</option>
                    @foreach (var proveedor in Model.ProveedoresDisponibles)
                    {
                        <option value="@proveedor.id">@proveedor.nombre</option>
                    }
                </select>
                <span asp-validation-for="fk_proveedor" class="text-danger"></span>
            </div>

            @if (!esEdicion)
            {
                <div class="col-12 form-group">
                    <label asp-for="NuevasImagenes" class="form-label"></label>
                    <input asp-for="NuevasImagenes" type="file" class="form-control" multiple accept="@STAT_Academy.Web.Models.Admin.ProductoFormViewModel.AcceptImagenes" />
                    <div class="form-text">JPG, PNG, GIF o WEBP de hasta 5 MB. La primera será la imagen principal; podrá cambiarla después.</div>
                </div>
            }

            <div class="col-12 d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">
                    @(esEdicion ? "Guardar cambios" : "Crear producto")
                </button>
                <a class="btn btn-outline-secondary" asp-action="Products">Cancelar</a>
            </div>
        </form>

        @if (esEdicion)
        {
            <hr class="my-4" />
            <h2 class="h4">Imágenes</h2>
            <p class="text-muted">
                La <strong>principal</strong> aparece en el catálogo; las demás, en el carrusel del detalle del producto.
            </p>

            @if (Model.Imagenes.Count == 0)
            {
                <div class="info-block mb-3">
                    <p class="mb-0">Este producto aún no tiene imágenes. En la tienda se mostrará sin foto.</p>
                </div>
            }
            else
            {
                <div class="blog-adjuntos mb-4">
                    @foreach (var imagen in Model.Imagenes)
                    {
                        <figure class="blog-adjunto @(imagen.es_principal ? "blog-adjunto--principal" : "")">
                            <img src="@imagen.url" alt="@imagen.nombre" loading="lazy" />
                            <figcaption>
                                <span class="blog-adjunto__nombre" title="@imagen.nombre">@imagen.nombre</span>
                                @if (imagen.es_principal)
                                {
                                    <span class="tag">Principal</span>
                                }
                                else
                                {
                                    <form asp-action="ImagenPrincipalProducto" method="post">
                                        <input type="hidden" name="id" value="@Model.id" />
                                        <input type="hidden" name="imagenId" value="@imagen.id" />
                                        <button type="submit" class="btn btn-link btn-sm p-0">Hacer principal</button>
                                    </form>
                                }
                                <form asp-action="QuitarImagenProducto" method="post">
                                    <input type="hidden" name="id" value="@Model.id" />
                                    <input type="hidden" name="imagenId" value="@imagen.id" />
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger"
                                            onclick="return confirm('¿Eliminar esta imagen?');">Eliminar</button>
                                </form>
                            </figcaption>
                        </figure>
                    }
                </div>
            }

            <form asp-action="SubirImagenesProducto" method="post" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-end">
                <input type="hidden" name="id" value="@Model.id" />
                <div class="flex-grow-1">
                    <label class="form-label" for="imagenes">Agregar imágenes</label>
                    <input id="imagenes" name="imagenes" type="file" class="form-control" multiple required
                           accept="@STAT_Academy.Web.Models.Admin.ProductoFormViewModel.AcceptImagenes" />
                </div>
                <button type="submit" class="btn btn-outline-primary">Subir</button>
            </form>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}