@model STAT_Academy.Web.Models.Admin.ProductoFormViewModel

@{
    var esEdicion = Model.id != null;
    ViewData["Title"] = esEdicion ? "Editar producto" : "Nuevo producto";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section class="card p-4">
        <span class="eyebrow">Administración</span>
        <h1>@(esEdicion ? "Editar producto" : "Nuevo producto")</h1>

        <div asp-validation-summary="All" class="text-danger mt-2"></div>

        <form asp-action="ProductForm" method="post" class="row g-3 mt-2">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="id" />

            <div class="col-md-6 form-group">
                <label asp-for="nombre">Nombre</label>
                <input class="form-control" asp-for="nombre" />
                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>

            <div class="col-md-6 form-group">
                <label asp-for="categoria">Categoría</label>
                <input class="form-control" asp-for="categoria" />
                <span asp-validation-for="categoria" class="text-danger"></span>
            </div>

            <div class="col-12 form-group">
                <label asp-for="descripcion">Descripción</label>
                <textarea class="form-control" asp-for="descripcion" rows="3"></textarea>
                <span asp-validation-for="descripcion" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group">
                <label asp-for="precio_base">Precio</label>
                <input class="form-control" asp-for="precio_base" type="number" step="0.01" />
                <span asp-validation-for="precio_base" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group">
                <label asp-for="stock">Existencias</label>
                <input class="form-control" asp-for="stock" type="number" />
                <span asp-validation-for="stock" class="text-danger"></span>
            </div>

            <div class="col-md-4 form-group">
                <label asp-for="min_stock">Stock mínimo</label>
                <input class="form-control" asp-for="min_stock" type="number" />
                <span asp-validation-for="min_stock" class="text-danger"></span>
            </div>

            <div class="col-md-6 form-group">
                <label asp-for="fk_proveedor">Proveedor</label>
                <select class="form-control" asp-for="fk_proveedor">
                    <option value="">Selecciona un proveedor...</option>
                    @foreach (var proveedor in Model.ProveedoresDisponibles)
                    {
                        <option value="@proveedor.id">@proveedor.nombre</option>
                    }
                </select>
                <span asp-validation-for="fk_proveedor" class="text-danger"></span>
            </div>

            <div class="col-12 d-flex gap-2 mt-4">
                <button class="btn btn-primary" type="submit">
                    @(esEdicion ? "Guardar cambios" : "Crear producto")
                </button>
                <a class="btn btn-outline-secondary" asp-action="Products">Cancelar</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}