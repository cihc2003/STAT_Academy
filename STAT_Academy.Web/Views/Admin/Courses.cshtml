@model IEnumerable<Course>
@{ ViewData["Title"] = "Cursos"; }
<div class="container admin-shell"><partial name="_AdminNav" /><section>
    <div class="d-flex justify-content-between align-items-center mb-3"><h1>Cursos</h1><a class="btn btn-primary" asp-action="CourseForm">Nuevo curso</a></div>
    <div class="table-card"><table class="table align-middle mb-0"><thead><tr><th>Curso</th><th>Categoría</th><th>Tutor</th><th>Precio</th><th>Estado</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td>@item.Title</td><td>@item.Category</td><td>@item.Tutor?.FullName</td><td>@item.Price.ToString("C")</td><td><span class="status-pill">@(item.IsActive ? "Activo" : "Inactivo")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="CourseForm" asp-route-id="@item.Id">Editar</a> <form asp-action="ToggleCourse" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Cambiar estado</button></form></td></tr> }
    </tbody></table></div>
</section></div>
