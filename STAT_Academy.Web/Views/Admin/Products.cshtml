@model IEnumerable<STAT_Academy.Web.Models.Admin.ProductoViewModel>

@{
    ViewData["Title"] = "Productos";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <span class="eyebrow">Administración</span>
                <h1>Productos</h1>
            </div>

            <a class="btn btn-primary" asp-action="ProductForm">
                Agregar producto
            </a>
        </div>

        @{
            var totalStockBajo = (int)(ViewBag.TotalStockBajo ?? 0);
            var filtroStockBajo = (bool)(ViewBag.FiltroStockBajo ?? false);
        }

        @if (totalStockBajo > 0)
        {
            <div class="alert alert-warning d-flex flex-wrap justify-content-between align-items-center gap-2" role="status">
                <span>
                    <strong>@totalStockBajo @(totalStockBajo == 1 ? "producto tiene" : "productos tienen")</strong>
                    las existencias en el mínimo o por debajo. Conviene reponerlos.
                </span>
                @if (filtroStockBajo)
                {
                    <a class="btn btn-sm btn-outline-dark" asp-action="Products">Ver todos</a>
                }
                else
                {
                    <a class="btn btn-sm btn-dark" asp-action="Products" asp-route-stockBajo="true">Ver solo stock bajo</a>
                }
            </div>
        }

        <form class="row g-2 mb-3" method="get" asp-action="Products">
            <div class="col-md-10">
                <input class="form-control"
                       name="search"
                       value="@Context.Request.Query["search"]"
                       placeholder="Buscar por nombre o categoría" />
            </div>

            <div class="col-md-2">
                <button class="btn btn-primary w-100" type="submit">Filtrar</button>
            </div>
        </form>

        <div class="table-card">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th></th>
                        <th>Nombre</th>
                        <th>Categoría</th>
                        <th>Precio</th>
                        <th>Stock</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>

                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No se encontraron productos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var producto in Model)
                        {
                            <tr>
                                <td style="width: 64px;">
                                    @if (!string.IsNullOrEmpty(producto.imagen_principal))
                                    {
                                        <img src="@producto.imagen_principal" alt="" class="producto-miniatura" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="producto-miniatura producto-miniatura--vacia" title="Sin imagen">—</span>
                                    }
                                </td>
                                <td>
                                    <strong>@producto.nombre</strong>
                                    <div class="text-muted small">#@producto.id</div>
                                </td>
                                <td>@producto.categoria</td>
                                <td>@Formato.Colones(producto.precio_base)</td>
                                <td>
                                    <strong class="@(producto.stock_bajo && producto.estado ? "text-danger" : "")">@producto.stock</strong>
                                    <span class="text-muted small">/ mín. @producto.min_stock</span>
                                    @if (producto.estado && producto.stock <= 0)
                                    {
                                        <div><span class="status-pill tutor-pill--alerta">Agotado</span></div>
                                    }
                                    else if (producto.estado && producto.stock_bajo)
                                    {
                                        <div><span class="status-pill tutor-pill--alerta">Stock bajo</span></div>
                                    }
                                </td>
                                <td>
                                    <span class="status-pill @(producto.estado ? "" : "tutor-pill--gris")">
                                        @(producto.estado ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-outline-primary"
                                       asp-action="ProductForm"
                                       asp-route-id="@producto.id">
                                        Editar
                                    </a>

                                    @if (producto.estado)
                                    {
                                        <form asp-action="ToggleProduct"
                                              asp-route-id="@producto.id"
                                              method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Eliminar este producto de la tienda?');">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-danger" type="submit">
                                                Eliminar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="ToggleProductOn"
                                              asp-route-id="@producto.id"
                                              method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-success" type="submit">
                                                Reactivar
                                            </button>
                                        </form>
                                    }

                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>