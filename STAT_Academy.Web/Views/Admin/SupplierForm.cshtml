@model Supplier
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo proveedor" : "Editar proveedor"; }
<div class="container admin-shell"><partial name="_AdminNav" /><section class="card p-4">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="SupplierForm" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6 form-group"><label asp-for="Name"></label><input asp-for="Name" /><span asp-validation-for="Name" class="text-danger"></span></div>
            <div class="col-md-6 form-group"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="col-md-6 form-group"><label asp-for="Phone"></label><input asp-for="Phone" /><span asp-validation-for="Phone" class="text-danger"></span></div>
            <div class="col-md-6 form-group"><label asp-for="Address"></label><input asp-for="Address" /></div>
            <div class="col-12"><label class="d-flex gap-2"><input asp-for="IsActive" /> Activo</label></div>
        </div>
        <button class="btn btn-primary mt-3">Guardar</button>
    </form>
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
