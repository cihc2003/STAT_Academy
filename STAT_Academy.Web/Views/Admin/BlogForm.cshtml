@model BlogPost
@{ ViewData["Title"] = Model.Id == 0 ? "Nueva publicación" : "Editar publicación"; }
<div class="container admin-shell"><partial name="_AdminNav" /><section class="card p-4">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="BlogForm" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="form-group mb-3"><label asp-for="Title"></label><input asp-for="Title" /></div>
        <div class="form-group mb-3"><label asp-for="Category"></label><input asp-for="Category" /></div>
        <div class="form-group mb-3"><label asp-for="Summary"></label><textarea asp-for="Summary" rows="2"></textarea></div>
        <div class="form-group mb-3"><label asp-for="Content"></label><textarea asp-for="Content" rows="8"></textarea></div>
        <label class="d-flex gap-2"><input asp-for="IsActive" /> Activa</label>
        <button class="btn btn-primary mt-3">Guardar</button>
    </form>
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
