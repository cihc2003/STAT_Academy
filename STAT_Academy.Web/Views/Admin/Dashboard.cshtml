@{
    ViewData["Title"] = "Panel Administrador";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />
    <section>
        <div class="section-heading">
            <span class="eyebrow">Administración</span>
            <h1>Panel de control STAT Academy</h1>
            <p>Resumen operativo de usuarios, productos, cursos y matrículas.</p>
        </div>

        @{
            var stockBajo = ViewBag.StockBajo as List<STAT_Academy.Web.Models.Productos.ProductoResponse> ?? new();
        }

        @if (stockBajo.Count > 0)
        {
            <div class="card p-4 mb-4 alerta-stock" role="status">
                <div class="d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">⚠ Stock bajo (@stockBajo.Count)</h2>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Products" asp-route-stockBajo="true">Ver productos</a>
                </div>
                <ul class="list-unstyled mb-0 mt-3">
                    @foreach (var p in stockBajo.Take(5))
                    {
                        <li class="d-flex justify-content-between py-1 border-bottom">
                            <a asp-action="ProductForm" asp-route-id="@p.id">@p.nombre</a>
                            <span><strong class="text-danger">@p.stock</strong> <span class="text-muted">/ mín. @p.min_stock</span></span>
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="card-grid four">
            <div class="stat-box">
                <strong>@ViewBag.Users</strong>
                <span>Usuarios</span>
            </div>
            <div class="stat-box">
                <strong>@ViewBag.Products</strong>
                <span>Productos</span>
            </div>
            <div class="stat-box">
                <strong>@ViewBag.Courses</strong>
                <span>Cursos</span>
            </div>
            <div class="stat-box">
                <strong>@ViewBag.Enrollments</strong>
                <span>Matrículas</span>
            </div>
        </div>
    </section>
</div>