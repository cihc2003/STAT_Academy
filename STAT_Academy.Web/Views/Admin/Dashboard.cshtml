@{
    ViewData["Title"] = "Panel de control";

    var stockBajo = ViewBag.StockBajo as List<STAT_Academy.Web.Models.Productos.ProductoResponse> ?? new();
    var pagosPendientes = (int)(ViewBag.PagosPendientes ?? 0);
    var nombre = User.Identity?.Name ?? "";

    const string IconoUsuarios = "<path d=\"M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2\"/><circle cx=\"9\" cy=\"7\" r=\"4\"/><path d=\"M22 21v-2a4 4 0 0 0-3-3.87\"/><path d=\"M16 3.13a4 4 0 0 1 0 7.75\"/>";
    const string IconoCursos = "<path d=\"M22 10 12 5 2 10l10 5 10-5z\"/><path d=\"M6 12v5c3 2 9 2 12 0v-5\"/>";
    const string IconoProductos = "<path d=\"M21 8 12 3 3 8v8l9 5 9-5V8z\"/><path d=\"m3 8 9 5 9-5\"/><path d=\"M12 13v8\"/>";
    const string IconoFacturas = "<path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"/><path d=\"M14 2v6h6\"/><path d=\"M8 13h8\"/><path d=\"M8 17h5\"/>";
    const string IconoMas = "<path d=\"M12 5v14\"/><path d=\"M5 12h14\"/>";
}

<div class="container admin-shell">
    <partial name="_AdminNav" />

    <section>
        <div class="panel-encabezado">
            <div>
                <span class="eyebrow">Administración</span>
                <h1>Panel de control</h1>
                <p>@(string.IsNullOrWhiteSpace(nombre) ? "Hola." : $"Hola, {nombre}.") Este es el resumen de usuarios, cursos, productos y pagos.</p>
            </div>
        </div>

        <div class="panel-metricas">
            <a class="panel-metrica panel-metrica--violeta" asp-controller="Usuario" asp-action="Index">
                <span class="panel-metrica__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(IconoUsuarios)</svg>
                </span>
                <div><strong>@ViewBag.Users</strong><span>Usuarios</span></div>
            </a>
            <a class="panel-metrica" asp-action="Courses">
                <span class="panel-metrica__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(IconoCursos)</svg>
                </span>
                <div><strong>@ViewBag.Courses</strong><span>Cursos</span></div>
            </a>
            <a class="panel-metrica panel-metrica--cielo" asp-action="Products">
                <span class="panel-metrica__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(IconoProductos)</svg>
                </span>
                <div><strong>@ViewBag.Products</strong><span>Productos</span></div>
            </a>
            <a class="panel-metrica panel-metrica--verde" asp-action="Invoices">
                <span class="panel-metrica__icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">@Html.Raw(IconoFacturas)</svg>
                </span>
                <div><strong>@pagosPendientes</strong><span>Pagos por verificar</span></div>
            </a>
        </div>

        <div class="panel-columnas">
            <div class="panel-tarjeta">
                <h2 class="panel-tarjeta__titulo">Pendientes</h2>

                @if (pagosPendientes == 0 && stockBajo.Count == 0)
                {
                    <p class="panel-ok">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                        Todo al día: no hay pagos por verificar ni productos con stock bajo.
                    </p>
                }

                @if (pagosPendientes > 0)
                {
                    <div class="panel-aviso panel-aviso--info" role="status">
                        <p>
                            <strong>@pagosPendientes @(pagosPendientes == 1 ? "comprobante de pago espera" : "comprobantes de pago esperan")</strong>
                            su verificación.
                        </p>
                        <a class="btn btn-sm btn-primary" asp-action="Invoices">Revisar pagos</a>
                    </div>
                }

                @if (stockBajo.Count > 0)
                {
                    <div class="panel-aviso mb-2" role="status">
                        <p><strong>@stockBajo.Count @(stockBajo.Count == 1 ? "producto tiene" : "productos tienen")</strong> stock bajo.</p>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Products" asp-route-stockBajo="true">Ver productos</a>
                    </div>
                    <ul class="panel-lista">
                        @foreach (var p in stockBajo.Take(5))
                        {
                            <li>
                                <a asp-action="ProductForm" asp-route-id="@p.id">@p.nombre</a>
                                <span class="text-nowrap"><strong class="text-danger">@p.stock</strong> <span class="text-muted small">/ mín. @p.min_stock</span></span>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="panel-tarjeta">
                <h2 class="panel-tarjeta__titulo">Accesos rápidos</h2>
                <div class="panel-accesos">
                    <a asp-controller="Usuario" asp-action="UserForm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(IconoMas)</svg>
                        Nuevo usuario
                    </a>
                    <a asp-action="CourseForm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(IconoMas)</svg>
                        Nuevo curso
                    </a>
                    <a asp-action="ProductForm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(IconoMas)</svg>
                        Nuevo producto
                    </a>
                    <a asp-controller="Proveedor" asp-action="SupplierForm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(IconoMas)</svg>
                        Nuevo proveedor
                    </a>
                    <a asp-action="Invoices" asp-route-vista="facturas">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(IconoFacturas)</svg>
                        Todas las facturas
                    </a>
                    <a asp-controller="Tutor" asp-action="Index">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">@Html.Raw(IconoCursos)</svg>
                        Panel del tutor
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>
