@model IEnumerable<Supplier>
@{ ViewData["Title"] = "Proveedores"; }
<div class="container admin-shell"><partial name="_AdminNav" /><section>
    <div class="d-flex justify-content-between align-items-center mb-3"><h1>Proveedores</h1><a class="btn btn-primary" asp-action="SupplierForm">Nuevo proveedor</a></div>
    <div class="table-card"><table class="table align-middle mb-0"><thead><tr><th>Nombre</th><th>Correo</th><th>Teléfono</th><th>Estado</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td>@item.Name</td><td>@item.Email</td><td>@item.Phone</td><td><span class="status-pill">@(item.IsActive ? "Activo" : "Inactivo")</span></td><td class="text-end"><a class="btn btn-sm btn-outline-primary" asp-action="SupplierForm" asp-route-id="@item.Id">Editar</a> <form asp-action="ToggleSupplier" asp-route-id="@item.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-secondary">Cambiar estado</button></form></td></tr> }
    </tbody></table></div>
</section></div>
