@model Course
@{ ViewData["Title"] = Model.Id == 0 ? "Nuevo curso" : "Editar curso"; }
<div class="container admin-shell"><partial name="_AdminNav" /><section class="card p-4">
    <h1>@ViewData["Title"]</h1>
    <form asp-action="CourseForm" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="row g-3">
            <div class="col-md-6 form-group"><label asp-for="Title"></label><input asp-for="Title" /><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="col-md-6 form-group"><label asp-for="Category"></label><input asp-for="Category" /><span asp-validation-for="Category" class="text-danger"></span></div>
            <div class="col-md-12 form-group"><label asp-for="Description"></label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description" class="text-danger"></span></div>
            <div class="col-md-4 form-group"><label asp-for="DurationWeeks"></label><input asp-for="DurationWeeks" /></div>
            <div class="col-md-4 form-group"><label asp-for="Price"></label><input asp-for="Price" /></div>
            <div class="col-md-4 form-group"><label asp-for="TutorId">Tutor</label><select asp-for="TutorId" asp-items="ViewBag.Tutors" class="form-select"><option value="">Sin tutor</option></select></div>
            <div class="col-12"><label class="d-flex gap-2"><input asp-for="IsActive" /> Activo</label></div>
        </div>
        <button class="btn btn-primary mt-3">Guardar</button>
    </form>
</section></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
