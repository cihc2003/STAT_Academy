@model IEnumerable<Enrollment>
@{ ViewData["Title"] = "Matrículas"; }
<div class="container admin-shell"><partial name="_AdminNav" /><section>
    <h1>Matrículas</h1>
    <div class="table-card"><table class="table align-middle mb-0"><thead><tr><th>Estudiante</th><th>Curso</th><th>Estado</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) { <tr><td>@item.Student?.FullName</td><td>@item.Course?.Title</td><td><span class="status-pill">@item.Status</span></td><td class="text-end"><form asp-action="UpdateEnrollment" method="post" class="d-inline"><input type="hidden" name="id" value="@item.Id"><button name="status" value="Aprobada" class="btn btn-sm btn-success">Aprobar</button><button name="status" value="Rechazada" class="btn btn-sm btn-outline-danger">Rechazar</button></form></td></tr> }
    </tbody></table></div>
</section></div>
