@model STAT_Academy.Web.Models.Perfil.PerfilViewModel

@{
    ViewData["Title"] = "Mis datos";
    var rol = Model.Datos.tipo switch
    {
        "Admin" => "Administrador",
        "Tutor" => "Tutor",
        "Cliente" => "Estudiante",
        _ => "Usuario"
    };
    var nombre = string.IsNullOrWhiteSpace(Model.Datos.nombre) ? User.Identity?.Name ?? "" : Model.Datos.nombre;
    var inicial = string.IsNullOrWhiteSpace(nombre) ? "?" : nombre.Trim()[..1].ToUpperInvariant();
    var esCliente = User.IsInRole("Cliente");
}

<div class="container admin-shell admin-shell--perfil">
    <partial name="_PerfilNav" />

    <div class="perfil-contenido">
        @* Cabecera de la cuenta: identidad y datos clave a todo el ancho *@
        <section class="perfil-resumen" aria-labelledby="perfil-titulo">
            <span class="usuario-avatar usuario-avatar--grande perfil-resumen__avatar" aria-hidden="true">@inicial</span>
            <div class="perfil-resumen__texto">
                <span class="eyebrow">Mi cuenta</span>
                <h1 id="perfil-titulo">@nombre</h1>
                <p>@Model.Datos.email</p>
            </div>
            <dl class="perfil-resumen__datos">
                <div>
                    <dt>Rol</dt>
                    <dd>@rol</dd>
                </div>
                <div>
                    <dt>Miembro desde</dt>
                    <dd>@Formato.Fecha(Model.Datos.fecha_Registro)</dd>
                </div>
                <div>
                    <dt>Último ingreso</dt>
                    <dd>@Formato.FechaHora(Model.Datos.ultimo_Login)</dd>
                </div>
            </dl>
        </section>

        <div class="perfil-columnas">
            <section class="panel-tarjeta" aria-labelledby="perfil-editar">
                <h2 id="perfil-editar" class="panel-tarjeta__titulo">Datos personales</h2>
                <p class="form-text mt-0 mb-4">El nombre aparece en sus cursos y facturas. El correo identifica su cuenta y no se puede cambiar desde aquí.</p>

                <form asp-action="Index" method="post" class="perfil-form-ancho" data-un-solo-envio>
                    <div asp-validation-summary="ModelOnly" class="aviso aviso--error"></div>

                    <div class="perfil-form-ancho__campos">
                        <div class="form-group">
                            <label asp-for="Formulario.nombre"></label>
                            <input asp-for="Formulario.nombre" class="form-control" autocomplete="name" maxlength="150" />
                            <span asp-validation-for="Formulario.nombre" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label for="correo-cuenta">Correo electrónico</label>
                            <input id="correo-cuenta" class="form-control" value="@Model.Datos.email" readonly aria-describedby="correo-ayuda" />
                            <span id="correo-ayuda" class="form-text">No se puede cambiar.</span>
                        </div>
                    </div>

                    <div class="formulario__acciones">
                        <button class="btn btn-primary" type="submit">@Html.Icono("guardar", "icono--sm")Guardar cambios</button>
                    </div>
                </form>
            </section>

            <section class="panel-tarjeta" aria-labelledby="perfil-accesos">
                <h2 id="perfil-accesos" class="panel-tarjeta__titulo">Accesos rápidos</h2>
                <ul class="perfil-accesos">
                    <li>
                        <a asp-action="Contrasena">
                            <span class="panel-metrica__icono">@Html.Icono("escudo")</span>
                            <span><strong>Seguridad</strong><span>Cambiar la contraseña de la cuenta</span></span>
                            @Html.Icono("chevron-derecha", "icono--sm perfil-accesos__flecha")
                        </a>
                    </li>
                    @if (esCliente)
                    {
                        <li>
                            <a asp-controller="Curso" asp-action="MisCursos">
                                <span class="panel-metrica__icono">@Html.Icono("libro")</span>
                                <span><strong>Mis cursos</strong><span>Avance, tareas y calificaciones</span></span>
                                @Html.Icono("chevron-derecha", "icono--sm perfil-accesos__flecha")
                            </a>
                        </li>
                        <li>
                            <a asp-controller="Facturas" asp-action="Index">
                                <span class="panel-metrica__icono">@Html.Icono("factura")</span>
                                <span><strong>Facturas y pedidos</strong><span>Compras, pagos y comprobantes</span></span>
                                @Html.Icono("chevron-derecha", "icono--sm perfil-accesos__flecha")
                            </a>
                        </li>
                    }
                    else if (User.IsInRole("Admin"))
                    {
                        <li>
                            <a asp-controller="Admin" asp-action="Dashboard">
                                <span class="panel-metrica__icono">@Html.Icono("panel")</span>
                                <span><strong>Administración</strong><span>Usuarios, cursos, tienda y pagos</span></span>
                                @Html.Icono("chevron-derecha", "icono--sm perfil-accesos__flecha")
                            </a>
                        </li>
                    }
                    else if (User.IsInRole("Tutor"))
                    {
                        <li>
                            <a asp-controller="Tutor" asp-action="Index">
                                <span class="panel-metrica__icono">@Html.Icono("pizarra")</span>
                                <span><strong>Panel del tutor</strong><span>Cursos, tareas y calificaciones</span></span>
                                @Html.Icono("chevron-derecha", "icono--sm perfil-accesos__flecha")
                            </a>
                        </li>
                    }
                </ul>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
