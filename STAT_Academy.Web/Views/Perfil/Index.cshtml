@model STAT_Academy.Web.Models.Perfil.PerfilViewModel

@{
    ViewData["Title"] = "Mis datos";
    var rol = Model.Datos.tipo switch
    {
        "Admin" => "Administrador",
        "Tutor" => "Tutor",
        "Cliente" => "Estudiante",
        _ => "Usuario"
    };
}

<div class="container admin-shell admin-shell--perfil">
    <partial name="_PerfilNav" />

    <div class="perfil-contenido">
        <div class="perfil-encabezado">
            <span class="eyebrow">Mi cuenta</span>
            <h1>Mis datos</h1>
            <p>Revise los datos de su cuenta y actualice el nombre con el que aparece en la plataforma.</p>
        </div>

        <div class="card perfil-card">
            <h2 class="perfil-card__titulo">Datos de la cuenta</h2>
            <dl class="perfil-datos">
                <div>
                    <dt>Correo electrónico</dt>
                    <dd>@Model.Datos.email</dd>
                </div>
                <div>
                    <dt>Rol</dt>
                    <dd>@rol</dd>
                </div>
                <div>
                    <dt>Miembro desde</dt>
                    <dd>@Formato.Fecha(Model.Datos.fecha_Registro)</dd>
                </div>
                <div>
                    <dt>Último ingreso</dt>
                    <dd>@Formato.FechaHora(Model.Datos.ultimo_Login)</dd>
                </div>
            </dl>
            <p class="perfil-nota">El correo identifica su cuenta y no se puede cambiar desde aquí.</p>
        </div>

        <div class="card perfil-card">
            <h2 class="perfil-card__titulo">Editar nombre</h2>

            <form asp-action="Index" method="post" class="perfil-form">
                <div asp-validation-summary="ModelOnly" class="aviso aviso--error"></div>

                <div class="form-group mb-3">
                    <label asp-for="Formulario.nombre"></label>
                    <input asp-for="Formulario.nombre" autocomplete="name" maxlength="150" />
                    <span asp-validation-for="Formulario.nombre" class="text-danger"></span>
                </div>

                <button class="btn btn-primary" type="submit">Guardar cambios</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
