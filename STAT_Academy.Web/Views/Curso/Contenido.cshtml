@model STAT_Academy.Web.Models.Cursos.CursoContenidoViewModel

@{
    ViewData["Title"] = Model.Curso.nombre;
    var ahora = DateTime.Now;
    var abiertas = Model.Tareas.Count(t => t.FechaLimite >= ahora);
}

<section class="section">
    <div class="container">
        <a class="text-link" asp-controller="Curso" asp-action="MisCursos">&larr; Volver a mis cursos</a>

        <div class="section-heading mt-3">
            <span class="eyebrow">Aula virtual</span>
            <h1>@Model.Curso.nombre</h1>
            <p>@Model.Curso.descripcion</p>
        </div>

        <dl class="tutor-cifras tutor-cifras--fila mb-5">
            <div><dt>Inicio</dt><dd>@Model.Curso.fechaInicio.ToString("dd/MM/yyyy")</dd></div>
            <div><dt>Fin</dt><dd>@Model.Curso.fechaFin.ToString("dd/MM/yyyy")</dd></div>
            <div><dt>Tareas abiertas</dt><dd>@abiertas</dd></div>
            <div><dt>Material</dt><dd>@Model.Material.Count</dd></div>
        </dl>

        <div class="aula">
            @* ------------------------------ Tareas ------------------------------ *@
            <section aria-labelledby="titulo-tareas">
                <h2 id="titulo-tareas">Tareas</h2>

                @if (Model.Tareas.Count == 0)
                {
                    <div class="info-block">
                        <p class="mb-0">Tu tutor todavía no ha publicado tareas.</p>
                    </div>
                }
                else
                {
                    <ul class="aula-lista">
                        @foreach (var tarea in Model.Tareas)
                        {
                            var cerrada = tarea.FechaLimite < ahora;
                            var proxima = !cerrada && tarea.FechaLimite <= ahora.AddDays(3);

                            <li class="aula-item @(cerrada ? "aula-item--cerrada" : "")">
                                <div class="aula-item__fecha" aria-hidden="true">
                                    <span>@tarea.FechaLimite.ToString("dd")</span>
                                    <small>@tarea.FechaLimite.ToString("MMM").ToUpperInvariant()</small>
                                </div>
                                <div class="aula-item__cuerpo">
                                    <strong>@tarea.Titulo</strong>
                                    @if (!string.IsNullOrWhiteSpace(tarea.Descripcion))
                                    {
                                        <p class="mb-1">@tarea.Descripcion</p>
                                    }
                                    <span class="small text-muted">
                                        Entrega hasta el @tarea.FechaLimite.ToString("dd/MM/yyyy 'a las' HH:mm")
                                    </span>
                                </div>
                                <span class="status-pill @(cerrada ? "tutor-pill--gris" : proxima ? "tutor-pill--alerta" : "")">
                                    @(cerrada ? "Cerrada" : proxima ? "Vence pronto" : "Abierta")
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>

            @* ------------------------------ Material ------------------------------ *@
            <section aria-labelledby="titulo-material">
                <h2 id="titulo-material">Material</h2>

                @if (Model.Material.Count == 0)
                {
                    <div class="info-block">
                        <p class="mb-0">Todavía no hay material publicado.</p>
                    </div>
                }
                else
                {
                    <ul class="blog-documentos">
                        @foreach (var item in Model.Material)
                        {
                            <li>
                                <span class="blog-documentos__ext">@item.Tipo</span>
                                @if (item.EsEnlace)
                                {
                                    <a href="@item.UbicacionMaterial" target="_blank" rel="noopener">@item.Titulo</a>
                                    <span class="ms-auto small text-muted">Enlace</span>
                                }
                                else
                                {
                                    <a asp-controller="Curso" asp-action="Material" asp-route-id="@item.Id" data-sin-carga>@item.Titulo</a>
                                    <span class="ms-auto small text-muted">Descargar</span>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
</section>
