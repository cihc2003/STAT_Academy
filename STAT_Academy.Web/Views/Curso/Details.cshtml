@model STAT_Academy.Web.Models.CursoModel

@{
    ViewData["Title"] = Model.Nombre;
    var esPago = Model.Precio_Base > 0;
    var semanas = Model.Duracion_Semanas;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<section class="curso-hero">
    <div class="catalogo-ancho curso-hero__grid">
        <div class="curso-hero__texto">
            <a asp-action="Index" class="curso-hero__volver">← Cursos</a>
            <h1>@Model.Nombre</h1>
        </div>
        <partial name="_CursoPortada" model="Model" />
    </div>
</section>

<section class="catalogo-ancho curso-detalle">
    <article class="curso-detalle__descripcion">
        <h2>Sobre el curso</h2>
        <p>@Model.Descripcion</p>
    </article>

    <aside class="curso-compra" aria-label="Inscripción">
        <div class="curso-compra__precio">@(esPago ? Formato.Colones(Model.Precio_Base) : "Gratis")</div>

        <dl class="curso-compra__datos">
            <div>
                <dt>Inicio</dt>
                <dd>@Formato.FechaLarga(Model.Fecha_Inicio)</dd>
            </div>
            <div>
                <dt>Fin</dt>
                <dd>@Formato.FechaLarga(Model.Fecha_Fin)</dd>
            </div>
            <div>
                <dt>Duración</dt>
                <dd>@semanas @(semanas == 1 ? "semana" : "semanas")</dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.TutorNombre))
            {
                <div>
                    <dt>Tutor</dt>
                    <dd>@Model.TutorNombre</dd>
                </div>
            }
        </dl>

        @if (!Model.InscripcionAbierta)
        {
            <div class="curso-compra__aviso" role="status">
                Este curso ya inició y no acepta nuevas inscripciones.
            </div>
        }
        else if (User.Identity?.IsAuthenticated != true)
        {
            <a class="btn btn-primary w-100" asp-controller="Cuenta" asp-action="Login" asp-route-returnUrl="@returnUrl">
                Inicia sesión para inscribirte
            </a>
        }
        else if (User.IsInRole("Cliente"))
        {
            if (esPago)
            {
                @* Curso de pago: se genera la factura y el acceso se habilita al aprobarse el pago. *@
                <form asp-controller="Facturas" asp-action="ComprarCurso" method="post"
                      data-un-solo-envio>
                    <input type="hidden" name="cursoId" value="@Model.Id" />
                    <button class="btn btn-primary w-100" type="submit">Comprar curso</button>
                </form>
                <p class="curso-compra__nota">Tendrás acceso al curso cuando se apruebe el pago.</p>
            }
            else
            {
                <a asp-action="Inscribirse" asp-route-idCurso="@Model.Id" class="btn btn-primary w-100">Inscribirme</a>
            }
        }
    </aside>
</section>
