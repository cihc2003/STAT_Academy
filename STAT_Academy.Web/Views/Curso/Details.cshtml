@model STAT_Academy.Web.Models.CursoModel

@{
    ViewData["Title"] = "Detalle";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header">

            <h2>@Model.Nombre</h2>

        </div>

        <div class="card-body">

            <h5>Descripción</h5>

            <p>@Model.Descripcion</p>

            <hr />

            <p>

                <strong>Precio:</strong>

                @Formato.Colones(Model.Precio_Base)

            </p>

            <p>

                <strong>Duración:</strong>

                @Model.Duracion_Semanas semanas

            </p>

            <p>

                <strong>Inicio:</strong>

                @Model.Fecha_Inicio.ToShortDateString()

            </p>

            <p>

                <strong>Finaliza:</strong>

                @Model.Fecha_Fin.ToShortDateString()

            </p>

        </div>

        <div class="card-footer">

            @if (Model.Precio_Base > 0)
            {
                @* Curso de pago: se compra y el acceso se habilita al aprobarse el pago. *@
                @if (User.IsInRole("Cliente"))
                {
                    <form asp-controller="Facturas" asp-action="ComprarCurso" method="post" class="d-inline"
                          onsubmit="this.querySelector('button').disabled = true;">
                        <input type="hidden" name="cursoId" value="@Model.Id" />
                        <button class="btn btn-success" type="submit">Comprar curso · @Formato.Colones(Model.Precio_Base)</button>
                    </form>
                }
                else if (User.Identity?.IsAuthenticated != true)
                {
                    <a class="btn btn-success" asp-controller="Cuenta" asp-action="Login">Inicia sesión para comprar</a>
                }
            }
            else
            {
                <a asp-action="Inscribirse"
                   asp-route-idCurso="@Model.Id"
                   class="btn btn-success">

                    Inscribirme

                </a>
            }

            <a asp-action="Index"
               class="btn btn-secondary">

                Regresar

            </a>

        </div>

    </div>

</div>