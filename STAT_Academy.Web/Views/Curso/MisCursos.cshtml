@model List<STAT_Academy.Web.Models.Cursos.CursoCompradoResponse>

@{
    ViewData["Title"] = "Mis Cursos";
}

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Aula virtual</span>
            <h1>Mis cursos</h1>
            <p>Cursos en los que estás matriculado actualmente.</p>
        </div>

        @if (!Model.Any())
        {
            <p>Todavía no estás matriculado en ningún curso.</p>
            <a class="btn btn-primary" asp-controller="Curso" asp-action="Index">Explorar cursos</a>
        }
        else
        {
            <div class="card-grid three">
                @foreach (var curso in Model)
                {
                    <article class="card p-4">
                        <span class="tag">@curso.Estado</span>
                        <h3>@curso.NombreCurso</h3>
                        <p>@curso.Descripcion</p>

                        <div class="course-meta">
                            <span>Avance del curso</span>
                            <strong>@curso.Progreso%</strong>
                        </div>

                        <div class="progress mt-2 mb-1" style="height: 8px;" role="progressbar" aria-label="Avance del curso"
                             aria-valuenow="@curso.Progreso" aria-valuemin="0" aria-valuemax="100">
                            <div class="progress-bar" style="width: @curso.Progreso%;"></div>
                        </div>
                        <p class="small text-muted mb-3">
                            @if (curso.FechaInicio.Date > STAT_Academy.Web.Helpers.Formato.AhoraCostaRica.Date)
                            {
                                <text>Inicia el @curso.FechaInicio.ToString("dd/MM/yyyy")</text>
                            }
                            else if (curso.Progreso >= 100)
                            {
                                <text>Finalizó el @curso.FechaFin.ToString("dd/MM/yyyy")</text>
                            }
                            else
                            {
                                <text>Termina el @curso.FechaFin.ToString("dd/MM/yyyy")</text>
                            }
                        </p>

                        <div class="mis-cursos__acciones">
                            <a class="text-link" asp-controller="Curso" asp-action="Contenido" asp-route-id="@curso.CursoId">
                                Entrar al curso
                            </a>
                            <a class="text-link" asp-controller="Curso" asp-action="Calificaciones" asp-route-id="@curso.CursoId">
                                Calificaciones
                            </a>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>