@model List<STAT_Academy.Web.Models.Cursos.CursoCompradoResponse>

@{
    ViewData["Title"] = "Mis cursos";
    var hoy = STAT_Academy.Web.Helpers.Formato.AhoraCostaRica.Date;
}

<div class="container admin-shell admin-shell--perfil">
    <partial name="_PerfilNav" />

    <div class="perfil-contenido">
        <div class="perfil-encabezado">
            <span class="eyebrow">Aprendizaje</span>
            <h1>Mis cursos</h1>
            <p>Cursos en los que está matriculado: avance, fechas y acceso al aula.</p>
        </div>

        @if (!Model.Any())
        {
            <div class="vacio">
                <span class="vacio__icono">@Html.Icono("libro", "icono--lg")</span>
                <h2>Todavía no está matriculado en ningún curso</h2>
                <p>Cuando se inscriba o se apruebe el pago de un curso, aparecerá aquí.</p>
                <a class="btn btn-primary" asp-controller="Curso" asp-action="Index">Ver cursos disponibles</a>
            </div>
        }
        else
        {
            <div class="rejilla rejilla--amplia">
                @foreach (var curso in Model)
                {
                    var porIniciar = curso.FechaInicio.Date > hoy;
                    <article class="tarjeta-item mi-curso">
                        <div class="tarjeta-item__cuerpo">
                            <span class="estado estado--info">@curso.Estado</span>
                            <h2 class="tarjeta-item__titulo">
                                <a class="tarjeta-item__enlace" asp-controller="Curso" asp-action="Contenido" asp-route-id="@curso.CursoId">@curso.NombreCurso</a>
                            </h2>
                            @if (!string.IsNullOrWhiteSpace(curso.Descripcion))
                            {
                                <p class="tarjeta-item__resumen">@curso.Descripcion</p>
                            }

                            <div class="mi-curso__avance">
                                <div class="mi-curso__avance-texto">
                                    <span>Avance</span>
                                    <strong>@curso.Progreso %</strong>
                                </div>
                                <div class="progress" role="progressbar" aria-label="Avance de @curso.NombreCurso"
                                     aria-valuenow="@curso.Progreso" aria-valuemin="0" aria-valuemax="100">
                                    <div class="progress-bar" data-progreso="@curso.Progreso"></div>
                                </div>
                            </div>

                            <ul class="datos-icono">
                                <li>
                                    @Html.Icono("calendario")
                                    <span>
                                        @if (porIniciar)
                                        {
                                            <text>Inicia el @Formato.FechaCorta(curso.FechaInicio)</text>
                                        }
                                        else if (curso.Progreso >= 100)
                                        {
                                            <text>Finalizó el @Formato.FechaCorta(curso.FechaFin)</text>
                                        }
                                        else
                                        {
                                            <text>Termina el @Formato.FechaCorta(curso.FechaFin)</text>
                                        }
                                    </span>
                                </li>
                            </ul>

                            <div class="tarjeta-item__pie mi-curso__acciones">
                                <span class="tarjeta-item__accion" aria-hidden="true">Entrar al aula @Html.Icono("chevron-derecha", "icono--sm")</span>
                                <a class="btn btn-sm btn-secundario mi-curso__secundaria" asp-controller="Curso" asp-action="Calificaciones" asp-route-id="@curso.CursoId">
                                    @Html.Icono("calificacion", "icono--sm")Calificaciones<span class="visually-hidden"> de @curso.NombreCurso</span>
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
