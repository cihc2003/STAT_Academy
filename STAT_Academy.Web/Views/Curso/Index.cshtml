@model IEnumerable<STAT_Academy.Web.Models.CursoModel>

@{
    ViewData["Title"] = "Cursos";
    var buscar = ViewData["Buscar"] as string;
    var total = ViewData["Total"] as int? ?? Model.Count();
    var filtrando = !string.IsNullOrWhiteSpace(buscar);
}

<section class="catalogo-hero">
    <div class="catalogo-ancho">
        <span class="eyebrow">Formación</span>
        <h1>Cursos</h1>

        <form method="get" asp-action="Index" class="catalogo-buscar" role="search" aria-label="Buscar cursos">
            <label for="buscar" class="visually-hidden">Buscar por nombre</label>
            <input id="buscar" name="buscar" type="search" class="form-control" value="@buscar"
                   placeholder="Buscar por nombre" autocomplete="off" />
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
</section>

<section class="catalogo-cuerpo">
    <div class="catalogo-ancho">
        <div class="catalogo-resumen" aria-live="polite">
            @if (filtrando)
            {
                <span>@Model.Count() de @total @(total == 1 ? "curso" : "cursos") para «@buscar»</span>
                <a asp-action="Index">Ver todos</a>
            }
            else if (total > 0)
            {
                <span>@total @(total == 1 ? "curso disponible" : "cursos disponibles")</span>
            }
        </div>

        @if (!Model.Any())
        {
            <div class="catalogo-vacio">
                <h2 class="h5 mb-0">@(filtrando ? "No hay cursos con ese nombre" : "Pronto habrá nuevos cursos")</h2>
            </div>
        }
        else
        {
            <div class="curso-grid">
                @foreach (var item in Model)
                {
                    <a asp-action="Details" asp-route-id="@item.Id" class="curso-tarjeta">
                        <partial name="_CursoPortada" model="item" />
                        <div class="curso-tarjeta__cuerpo">
                            <h2 class="curso-tarjeta__nombre">@item.Nombre</h2>
                            <span class="curso-tarjeta__precio">@(item.Precio_Base > 0 ? Formato.Colones(item.Precio_Base) : "Gratis")</span>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>
