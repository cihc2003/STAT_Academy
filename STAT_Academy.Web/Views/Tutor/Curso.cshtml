@using STAT_Academy.Web.Models.Tutor
@model TutorCursoPagina

@{
    ViewData["Title"] = Model.Curso.Nombre;
}

<section class="section">
    <div class="container">
        <partial name="_CursoNav" model="Model.Curso" />

        @* ------------------------------ Tareas ------------------------------ *@
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <h2 class="mb-0">Tareas</h2>
            <a class="btn btn-primary" asp-action="NuevaTarea" asp-route-id="@Model.Curso.Id">Nueva tarea</a>
        </div>

        @if (Model.Tareas.Count == 0)
        {
            <div class="info-block mb-5">
                <p class="mb-0">Todavía no hay tareas. Cree la primera para que los estudiantes puedan entregarla.</p>
            </div>
        }
        else
        {
            <div class="table-card mb-5">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tarea</th>
                            <th>Fecha límite</th>
                            <th>Entregas</th>
                            <th>Calificadas</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Tareas)
                        {
                            var porCalificar = t.Entregas - t.Calificadas;

                            <tr class="@(t.Estado ? "" : "tutor-fila--oculta")">
                                <td>
                                    <strong>@t.Titulo</strong>
                                    @if (!t.Estado)
                                    {
                                        <span class="status-pill tutor-pill--gris ms-1">Oculta</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(t.Descripcion))
                                    {
                                        <div class="text-muted small">@t.Descripcion</div>
                                    }
                                </td>
                                <td>
                                    @(t.FechaLimite?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                    @if (t.Vencida)
                                    {
                                        <div class="small text-muted">Cerrada</div>
                                    }
                                </td>
                                <td>@t.Entregas / @t.Estudiantes</td>
                                <td>
                                    @t.Calificadas
                                    @if (porCalificar > 0)
                                    {
                                        <span class="status-pill tutor-pill--alerta ms-1">@porCalificar pendientes</span>
                                    }
                                </td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="Entregas" asp-route-id="@t.Id">Ver entregas</a>
                                    <a class="btn btn-sm btn-link" asp-action="EditarTarea" asp-route-id="@t.Id">Editar</a>
                                    <form asp-action="EstadoTarea" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <input type="hidden" name="cursoId" value="@Model.Curso.Id" />
                                        <input type="hidden" name="activa" value="@(t.Estado ? "false" : "true")" />
                                        <button type="submit" class="btn btn-sm btn-link @(t.Estado ? "text-danger" : "text-success")">
                                            @(t.Estado ? "Ocultar" : "Publicar")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        @* ------------------------------ Material ------------------------------ *@
        <h2>Material del curso</h2>

        <div class="tutor-material">
            <div>
                @if (Model.Material.Count == 0)
                {
                    <p class="text-muted">Todavía no hay material publicado.</p>
                }
                else
                {
                    <ul class="blog-documentos">
                        @foreach (var m in Model.Material)
                        {
                            <li>
                                <span class="blog-documentos__ext">@m.Tipo</span>
                                @if (m.EsEnlace)
                                {
                                    <a href="@m.Url" target="_blank" rel="noopener">@m.Titulo</a>
                                }
                                else
                                {
                                    <a asp-action="Material" asp-route-id="@m.Id" data-sin-carga>@m.Titulo</a>
                                }
                                <form asp-action="QuitarMaterial" method="post" class="ms-auto">
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <input type="hidden" name="cursoId" value="@Model.Curso.Id" />
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger"
                                            onclick="return confirm('¿Quitar este material del curso?');">Quitar</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>

            <form asp-action="AgregarMaterial" method="post" enctype="multipart/form-data" class="card card-body blog-form">
                <h3 class="h5">Agregar material</h3>
                <input type="hidden" asp-for="NuevoMaterial.CursoId" />

                <div class="mb-3">
                    <label asp-for="NuevoMaterial.Titulo" class="form-label"></label>
                    <input asp-for="NuevoMaterial.Titulo" class="form-control" maxlength="100" />
                </div>

                <div class="mb-2">
                    <label asp-for="NuevoMaterial.Archivo" class="form-label"></label>
                    <input asp-for="NuevoMaterial.Archivo" type="file" class="form-control" accept="@MaterialFormViewModel.Accept" />
                </div>

                <div class="mb-3">
                    <label asp-for="NuevoMaterial.Enlace" class="form-label"></label>
                    <input asp-for="NuevoMaterial.Enlace" type="url" class="form-control" placeholder="https://…" />
                    <div class="form-text">@MaterialFormViewModel.Ayuda</div>
                </div>

                <button type="submit" class="btn btn-outline-primary">Agregar al curso</button>
            </form>
        </div>
    </div>
</section>
