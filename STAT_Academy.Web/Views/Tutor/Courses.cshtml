@model IEnumerable<Course>
@{ ViewData["Title"] = "Cursos asignados"; }
<section class="section"><div class="container"><h1>Cursos asignados</h1><div class="card-grid three">@foreach(var c in Model){<article class="card p-4"><span class="tag">@c.Category</span><h3>@c.Title</h3><p>@c.Description</p><a class="text-link" asp-action="Manage" asp-route-id="@c.Id">Gestionar</a></article>}</div></div></section>
