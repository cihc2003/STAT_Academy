@model STAT_Academy.Web.Models.Productos.TiendaViewModel
@{
    // Nombre real de la categoría (con sus tildes), no el texto tal como llegó en la URL.
    var categoriaReal = Model.Categorias
        .Select(c => c.nombre)
        .FirstOrDefault(n => STAT_Academy.Web.Helpers.Busqueda.Igual(n, Model.Categoria)) ?? Model.Categoria;
    var hayBusqueda = !string.IsNullOrWhiteSpace(Model.Buscar);
    var hayCategoria = !string.IsNullOrWhiteSpace(Model.Categoria);
}

<section class="encabezado-pagina">
    <div class="container encabezado-pagina__grid">
        <div>
            <h1>Tienda</h1>
            <p>Insumos, equipo y recursos educativos para la práctica clínica.</p>
        </div>

        <form method="get" asp-action="Index" class="buscador" role="search" aria-label="Buscar productos" data-sin-carga>
            <label for="buscar" class="visually-hidden">Buscar productos por nombre</label>
            @Html.Icono("buscar", "buscador__icono")
            <input id="buscar" name="buscar" type="search" class="form-control" value="@Model.Buscar"
                   placeholder="Ej.: ECG, estetoscopio" autocomplete="off" maxlength="100" />
            @if (hayCategoria)
            {
                <input type="hidden" name="categoria" value="@Model.Categoria" />
            }
            <button type="submit" class="btn btn-primary">Buscar</button>
        </form>
    </div>
</section>

<section class="section section--compacta">
    <div class="container">
        @if (Model.Categorias.Count > 0)
        {
            <nav class="lista-chips" aria-label="Filtrar por categoría">
                <a class="chip @(hayCategoria ? "" : "chip--activo")" asp-action="Index" asp-route-buscar="@Model.Buscar"
                   aria-current="@(hayCategoria ? null : "true")">Todas <span class="chip__cantidad">@Model.Total</span></a>
                @foreach (var (nombre, cantidad) in Model.Categorias)
                {
                    var elegida = STAT_Academy.Web.Helpers.Busqueda.Igual(nombre, Model.Categoria);
                    <a class="chip @(elegida ? "chip--activo" : "")" asp-action="Index" asp-route-categoria="@nombre" asp-route-buscar="@Model.Buscar"
                       aria-current="@(elegida ? "true" : null)">
                        @nombre <span class="chip__cantidad"><span class="visually-hidden">, </span>@cantidad<span class="visually-hidden"> @(cantidad == 1 ? "producto" : "productos")</span></span>
                    </a>
                }
            </nav>
        }

        <h2 class="visually-hidden">Resultados</h2>
        <div class="resultados" aria-live="polite">
            @if (Model.Filtrando)
            {
                <p class="resultados__texto">
                    <strong>@Model.Encontrados</strong> de @Model.Total @(Model.Total == 1 ? "producto" : "productos")
                    @if (hayBusqueda) { <text>para «@Model.Buscar»</text> }
                    @if (!string.IsNullOrWhiteSpace(categoriaReal)) { <text>en @categoriaReal</text> }
                </p>
                <a class="enlace-accion" asp-action="Index">Quitar filtros</a>
            }
            else
            {
                <p class="resultados__texto"><strong>@Model.Total</strong> @(Model.Total == 1 ? "producto" : "productos") en la tienda</p>
            }
        </div>

        @if (!Model.Productos.Any())
        {
            <div class="vacio">
                <span class="vacio__icono">@Html.Icono("caja", "icono--lg")</span>
                @if (Model.Filtrando)
                {
                    <h3>No hay productos con esos filtros</h3>
                    <p>Pruebe con otro nombre o elija otra categoría.</p>
                    <a asp-action="Index" class="btn btn-secundario">Ver todos los productos</a>
                }
                else
                {
                    <h3>La tienda no tiene productos por ahora</h3>
                    <p>Vuelva pronto: los productos nuevos aparecen aquí en cuanto se publican.</p>
                    <a asp-controller="Curso" asp-action="Index" class="btn btn-secundario">Ver cursos</a>
                }
            </div>
        }
        else
        {
            <div class="rejilla">
                @foreach (var producto in Model.Productos)
                {
                    <partial name="_ProductoTarjeta" model="producto" />
                }
            </div>
            <partial name="_Paginador" model="(Paginacion)ViewBag.Paginacion" />
        }
    </div>
</section>
