@model List<STAT_Academy.Web.Models.Productos.ProductoResponse>

<section class="section">
    <div class="container">
        <div class="section-heading">
            <span class="eyebrow">Tienda</span>
            <h1>Materiales y recursos</h1>
            <p>Explora nuestro catálogo de productos y recursos educativos.</p>
        </div>

        @if (!Model.Any())
        {
            <p>No hay productos disponibles por el momento.</p>
        }
        else
        {
            <div class="card-grid three">
                @foreach (var producto in Model)
                {
                    <article class="card p-4">
                        <span class="tag">@producto.categoria</span>
                        <h3>@producto.nombre</h3>
                        <p>@producto.descripcion</p>
                        <div class="course-meta">
                            <span>Existencias @producto.stock</span>
                            <strong>@producto.precio_base.ToString("C")</strong>
                        </div>
                        <a class="text-link" asp-controller="Products" asp-action="Details" asp-route-id="@producto.id">Ver detalle</a>
                    </article>
                }
            </div>
        }
    </div>
</section>